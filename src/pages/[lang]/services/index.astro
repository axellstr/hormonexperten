---
import ClosingCta from '../../../components/sections/ClosingCta.astro';
import HowItWorks from '../../../components/sections/HowItWorks.astro';
import ServiceList from '../../../components/sections/ServiceList.astro';
import { LOCALES, type Locale } from '../../../config';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getHome, getServices, getSite, visible } from '../../../lib/content';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const site = await getSite(lang);
const home = await getHome(lang);
const services = await getServices(lang);
---

<BaseLayout
  lang={lang}
  site={site}
  title={services.meta.title}
  description={services.meta.description}
>
  <ServiceList lang={lang} services={services} items={visible(site.services)} />
  <HowItWorks
    lang={lang}
    how={home.how}
    doctor={home.team.members[0].name}
    followUpDoctor={home.team.members[1]?.name}
  />
  <ClosingCta closing={home.closing} />
</BaseLayout>
