---
import ClosingCta from '../../../components/sections/ClosingCta.astro';
import Faq from '../../../components/sections/Faq.astro';
import HowItWorks from '../../../components/sections/HowItWorks.astro';
import RelatedServices from '../../../components/sections/RelatedServices.astro';
import ServiceAbout from '../../../components/sections/ServiceAbout.astro';
import ServiceComparison from '../../../components/sections/ServiceComparison.astro';
import ServiceHero from '../../../components/sections/ServiceHero.astro';
import { LOCALES, type Locale } from '../../../config';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  getFaq,
  getHome,
  getServices,
  getSite,
  isVisible,
  servicePageLang,
  visible,
} from '../../../lib/content';
import type { Service, ServicePage } from '../../../lib/schemas';

// One page per visible service whose page is visible too. Every service needs a page, since the
// header, home row and footer all link to it.
export async function getStaticPaths() {
  const paths = await Promise.all(
    LOCALES.map(async (lang) => {
      const pages = (await getServices(lang)).pages;
      return visible((await getSite(lang)).services).flatMap((service) => {
        const page = pages.find((item) => item.id === service.id);
        if (!page) throw new Error(`Service "${service.id}" has no page in src/content/services/`);
        return isVisible(page)
          ? [{ params: { lang, service: service.id }, props: { lang, service, page } }]
          : [];
      });
    }),
  );
  return paths.flat();
}

interface Props {
  lang: Locale;
  service: Service;
  page: ServicePage;
}

const { lang, service, page } = Astro.props;
const site = await getSite(lang);
const home = await getHome(lang);
const services = await getServices(lang);

const faqItems = new Map(
  (await getFaq(lang)).categories
    .flatMap((category) => category.items)
    .map((item) => [item.id, item]),
);
const questions = visible(
  page.faq.map((id) => {
    const item = faqItems.get(id);
    if (!item) throw new Error(`Service page "${page.id}" lists unknown FAQ item "${id}"`);
    return item;
  }),
);

// The other services that have a page of their own.
const others = visible(site.services).filter(
  (other) =>
    other.id !== service.id &&
    services.pages.some((item) => item.id === other.id && isVisible(item)),
);

// Untranslated page text falls back to English; say so for screen readers.
const contentLangs = {
  about: await servicePageLang(lang, page.id),
  comparison: await servicePageLang(lang, page.id, 'comparison'),
};
const fallbackLang = (key: 'about' | 'comparison' = 'about') => {
  const contentLang = contentLangs[key];
  return contentLang === lang ? undefined : contentLang;
};
---

<BaseLayout
  lang={lang}
  site={site}
  title={page.meta.title}
  description={page.meta.description ?? service.summary}
>
  <ServiceHero lang={lang} services={services} service={service} />
  <div lang={fallbackLang()}>
    <ServiceAbout about={page.about} focus={page.focus} />
  </div>
  {page.comparison && (
    <div lang={fallbackLang('comparison')}>
      <ServiceComparison comparison={page.comparison} />
    </div>
  )}
  <HowItWorks
    lang={lang}
    how={home.how}
    doctor={home.team.members[0].name}
    followUpDoctor={home.team.members[1]?.name}
  />
  <Faq lang={lang} title={home.faq.title} contact={home.faq.contact} items={questions} />
  <RelatedServices lang={lang} title={services.others_title} items={others} />
  <ClosingCta closing={home.closing} />
</BaseLayout>
