---
import AboutHero from '../../components/sections/AboutHero.astro';
import AboutStory from '../../components/sections/AboutStory.astro';
import AboutTeam from '../../components/sections/AboutTeam.astro';
import AboutValues from '../../components/sections/AboutValues.astro';
import ClosingCta from '../../components/sections/ClosingCta.astro';
import ServiceSteps from '../../components/sections/ServiceSteps.astro';
import { LOCALES, type Locale } from '../../config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAbout, getHome, getSite, getTeam } from '../../lib/content';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const site = getSite(lang);
const home = getHome(lang);
const team = getTeam(lang);
const about = getAbout(lang);
---

<BaseLayout lang={lang} site={site} title={about.meta.title} description={about.meta.description}>
  <AboutHero hero={about.hero} />
  <AboutStory lang={lang} story={about.story} team={team} />
  <AboutValues values={about.values} />
  <ServiceSteps how={home.how} />
  <AboutTeam lang={lang} team={team} more={about.team.more} />
  <ClosingCta closing={home.closing} />
</BaseLayout>
