---
import ClosingCta from '../../components/sections/ClosingCta.astro';
import Faq from '../../components/sections/Faq.astro';
import PricingPackages from '../../components/sections/PricingPackages.astro';
import { LOCALES, type Locale } from '../../config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getFaq, getHome, getPricing, getSite, isVisible, visible } from '../../lib/content';

// Left out of builds while the prices are unconfirmed (`needs_check` in src/content/pricing/).
export async function getStaticPaths() {
  const paths = await Promise.all(
    LOCALES.map(async (lang) =>
      isVisible(await getPricing(lang)) ? [{ params: { lang }, props: { lang } }] : [],
    ),
  );
  return paths.flat();
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const site = await getSite(lang);
const home = await getHome(lang);
const pricing = await getPricing(lang);

const faqItems = new Map(
  (await getFaq(lang)).categories
    .flatMap((category) => category.items)
    .map((item) => [item.id, item]),
);
const questions = visible(
  pricing.faq.map((id) => {
    const item = faqItems.get(id);
    if (!item) throw new Error(`Pricing page lists unknown FAQ item "${id}"`);
    return item;
  }),
);
---

<BaseLayout
  lang={lang}
  site={site}
  title={pricing.meta.title}
  description={pricing.meta.description}
>
  <PricingPackages lang={lang} pricing={pricing} />
  <Faq lang={lang} title={home.faq.title} contact={home.faq.contact} items={questions} />
  <ClosingCta closing={home.closing} />
</BaseLayout>
