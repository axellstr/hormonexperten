---
import ClosingCta from '../../../components/sections/ClosingCta.astro';
import ConditionApproach from '../../../components/sections/ConditionApproach.astro';
import ConditionHero from '../../../components/sections/ConditionHero.astro';
import ConditionSymptoms from '../../../components/sections/ConditionSymptoms.astro';
import { LOCALES, type Locale } from '../../../config';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { resolveLink, resolveLinks } from '../../../lib/conditions';
import {
  conditionPageLang,
  getConditions,
  getHome,
  getSite,
  isVisible,
} from '../../../lib/content';
import type { ConditionPage } from '../../../lib/schemas';

export async function getStaticPaths() {
  const paths = await Promise.all(
    LOCALES.map(async (lang) =>
      (await getConditions(lang)).pages
        .filter(isVisible)
        .map((page) => ({ params: { lang, condition: page.id }, props: { lang, page } })),
    ),
  );
  return paths.flat();
}

interface Props {
  lang: Locale;
  page: ConditionPage;
}

const { lang, page } = Astro.props;
const site = await getSite(lang);
const home = await getHome(lang);
const conditions = await getConditions(lang);

const related = await resolveLinks(page.related, lang);
const listLinks = await Promise.all(
  (page.list?.items ?? []).map((item) => (item.link ? resolveLink(item.link, lang) : null)),
);

// Untranslated page text falls back to English; say so for screen readers.
const bodyLang = await conditionPageLang(lang, page.id);
const contentLang = bodyLang === lang ? undefined : bodyLang;
---

<BaseLayout
  lang={lang}
  site={site}
  title={`${page.name} | Hormonexperten`}
  description={page.summary}
>
  <ConditionHero lang={lang} contentLang={contentLang} conditions={conditions} page={page} />
  <ConditionSymptoms
    conditions={conditions}
    page={page}
    listLinks={listLinks}
    contentLang={contentLang}
  />
  <ConditionApproach
    conditions={conditions}
    page={page}
    related={related}
    contentLang={contentLang}
  />
  <ClosingCta closing={{ ...home.closing, cta: conditions.cta }} />
</BaseLayout>
