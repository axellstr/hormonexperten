---
import ClosingCta from '../../components/sections/ClosingCta.astro';
import ContactDetails from '../../components/sections/ContactDetails.astro';
import ContactFaq from '../../components/sections/ContactFaq.astro';
import ContactHero from '../../components/sections/ContactHero.astro';
import { LOCALES, type Locale } from '../../config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContact, getFaq, getHome, getSite, visible } from '../../lib/content';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const site = getSite(lang);
const contact = getContact(lang);

const faqItems = new Map(
  getFaq(lang)
    .categories.flatMap((category) => category.items)
    .map((item) => [item.id, item]),
);
const questions = visible(
  contact.faq.items.map((id) => {
    const item = faqItems.get(id);
    if (!item) throw new Error(`Contact page lists unknown FAQ item "${id}"`);
    return item;
  }),
);
---

<BaseLayout
  lang={lang}
  site={site}
  title={contact.meta.title}
  description={contact.meta.description}
>
  <ContactHero hero={contact.hero} channels={contact.channels} social={site.footer.social} />
  <ContactFaq lang={lang} faq={contact.faq} items={questions} />
  <ContactDetails lang={lang} details={contact.details} />
  <ClosingCta closing={getHome(lang).closing} />
</BaseLayout>
