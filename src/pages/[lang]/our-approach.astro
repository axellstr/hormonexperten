---
import ApproachHero from '../../components/sections/ApproachHero.astro';
import ApproachPillars from '../../components/sections/ApproachPillars.astro';
import ApproachQuote from '../../components/sections/ApproachQuote.astro';
import ClosingCta from '../../components/sections/ClosingCta.astro';
import HowItWorks from '../../components/sections/HowItWorks.astro';
import TeamBrief from '../../components/sections/TeamBrief.astro';
import { LOCALES, type Locale } from '../../config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getApproach, getHome, getSite, getTeam } from '../../lib/content';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const site = getSite(lang);
const home = getHome(lang);
const team = getTeam(lang);
const approach = getApproach(lang);
---

<BaseLayout
  lang={lang}
  site={site}
  title={approach.meta.title}
  description={approach.meta.description}
>
  <ApproachHero hero={approach.hero} />
  <ApproachPillars pillars={approach.pillars} />
  <ApproachQuote lang={lang} founder={approach.founder} team={team} />
  <HowItWorks lang={lang} how={home.how} doctor={home.team.members[0].name} />
  <TeamBrief lang={lang} team={team} more={approach.team.more} />
  <ClosingCta closing={home.closing} />
</BaseLayout>
