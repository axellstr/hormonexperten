  "services": [
    {
      "id": "hormone-therapy",
      "title": "Hormone therapy",
      "summary": "Approved hormone preparations in standard doses, such as gels, patches or tablets, for perimenopause, menopause, cycle problems and thyroid disorders. A well-studied option when you prefer it or when it suits your situation better.",
      "image": "service-hormone-therapy.jpg",
      "image_alt": ""
    },
    {
      "id": "bioidentical-hormone-therapy",
      "title": "Bioidentical hormone therapy",
      "summary": "Hormones molecule for molecule identical to your body’s own, individually prepared by a specialised compounding pharmacy and dosed according to your symptoms and blood values. We work with our own protocols and, on request, with the Rimkus method.",
      "image": "service-bioidentical-hormone-therapy.png",
      "image_alt": ""
    },
    {
      "id": "weight-metabolic-health",
      "title": "Weight & metabolic health",
      "summary": "We look at blood sugar, insulin, body composition and hormones together, and build a plan for nutrition, movement and, if appropriate, approved weight-loss medication under medical supervision.",
      "image": "service-weight-metabolic-health.jpg",
      "image_alt": ""
    },
    {
      "id": "micronutrient-medicine",
      "title": "Micronutrient medicine",
      "summary": "A personal micronutrient plan based on your symptoms, your lab results and the supplements you already take, so you only take what your body really needs.",
      "image": "service-micronutrient-medicine.jpg",
      "image_alt": ""
    },
    {
      "id": "digestive-gut-health",
      "title": "Digestive & gut health",
      "summary": "Bloating, constipation and digestive problems that change with your cycle or hormones, looked at as part of your whole treatment, not in isolation.",
      "image": "service-digestive-gut-health.jpg",
      "image_alt": ""
    },
    {
      "id": "chronic-condition-care",
      "title": "Chronic condition care",
      "summary": "For women living with long-standing or autoimmune conditions: we review your whole situation, including your current medication, and build a plan that looks at hormones, metabolism and inflammation together, alongside your specialists.",
      "image": "service-chronic-condition-care.jpg",
      "image_alt": ""
    }
  ],
