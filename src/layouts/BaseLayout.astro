---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';
import Footer from '../components/sections/Footer.astro';
import Header from '../components/sections/Header.astro';
import SeoHead from '../components/SeoHead.astro';
import { FONT_SUBSET, type Locale } from '../config';
import {
  HERO_IMAGE_HEIGHT,
  HERO_IMAGE_SIZES,
  HERO_IMAGE_WIDTH,
  HERO_IMAGE_WIDTHS,
  IMAGE_QUALITY,
} from '../lib/assets';
import { siteGraph } from '../lib/schema';
import type { Site } from '../lib/schemas';

interface Props {
  lang: Locale;
  site: Site;
  title: string;
  description: string;
  preloadImage?: ImageMetadata;
  /** Keep the page out of search results (and the sitemap). */
  noindex?: boolean;
}

const { lang, site, title, description, preloadImage, noindex } = Astro.props;
const path = Astro.url.pathname;
// The analytics script exists only on Vercel's servers, so local builds leave it out. Preview
// deployments build on Vercel too and include it.
const analytics = import.meta.env.PROD && process.env.VERCEL === '1';
const schema = await siteGraph(lang, site);
const imagePreload = preloadImage
  ? await getImage({
      src: preloadImage,
      format: 'avif',
      widths: HERO_IMAGE_WIDTHS,
      width: HERO_IMAGE_WIDTH,
      height: HERO_IMAGE_HEIGHT,
      quality: IMAGE_QUALITY,
      fit: 'cover',
      position: 'top',
    })
  : undefined;
---

<!doctype html>
<html lang={lang} class="scroll-pt-28 motion-safe:scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      lang={lang}
      title={title}
      description={description}
      path={path}
      noindex={noindex}
      schema={schema}
    />
    <link
      rel="preload"
      href={`/fonts/manrope-${FONT_SUBSET[lang]}-wght-normal.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {imagePreload && (
      <link
        rel="preload"
        as="image"
        href={imagePreload.src}
        imagesrcset={imagePreload.srcSet.attribute}
        imagesizes={HERO_IMAGE_SIZES}
        type="image/avif"
        fetchpriority="high"
      />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Chromium browsers render the page behind a link in the background once the pointer rests
         on it (or a finger presses it), so the click shows it at once. Rules, not a script. -->
    <script
      is:inline
      type="speculationrules"
      set:html={JSON.stringify({
        prerender: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }],
      })}
    />
    <!-- The surface colour token (--color-surface), as the hero panel. -->
    <meta name="theme-color" content="#fcf8f4" />
    <!-- Vercel Web Analytics: first-party and cookieless (privacy policy). The component starts
         when its element joins the page, so it waits in a template until a page Chromium
         prerenders on hover is shown: only real visits are counted. -->
    {analytics && (
      <>
        <template id="analytics">
          <Analytics />
        </template>
        <script is:inline>
          (() => {
            const load = () => {
              const template = document.getElementById('analytics');
              template.replaceWith(template.content);
            };
            if (document.prerendering) {
              document.addEventListener('prerenderingchange', load, { once: true });
            } else {
              load();
            }
          })();
        </script>
      </>
    )}
  </head>
  <body class="bg-bg font-sans text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-on-dark"
    >
      {site.skip_link}
    </a>
    <Header lang={lang} site={site} />
    <main id="main" class="pb-footer">
      <slot />
    </main>
    <Footer lang={lang} site={site} />
  </body>
</html>
