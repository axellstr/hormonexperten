---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
  href: string;
  variant?: 'primary' | 'secondary';
  /** `sm` is the compact header button; `full` fills its card, with room for longer labels. */
  size?: 'md' | 'sm' | 'full';
};

const { variant = 'primary', size = 'md', class: className, ...rest } = Astro.props;

// White labels on coral are the user's call (9 Oct 2026) despite 2.5:1 contrast (CLAUDE.md).
// Hover darkens rather than lightens, so the label doesn't lose more contrast.
const variants = {
  primary: 'bg-coral text-on-dark hover:brightness-95',
  secondary: 'border border-ink text-ink hover:bg-coral-tint',
};

const sizes = {
  md: 'min-h-13 px-9',
  sm: 'min-h-11 px-6',
  full: 'min-h-13 w-full px-5',
};
---

<a
  class:list={[
    'group/button inline-flex items-center justify-center rounded-full py-3 text-center text-base leading-tight font-semibold text-balance hyphens-none',
    'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink motion-safe:transition',
    variants[variant],
    sizes[size],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
