---
import type { HTMLAttributes } from 'astro/types';
import Container from './Container.astro';

type Props = HTMLAttributes<'section'>;

const { class: className, ...rest } = Astro.props;

// Top padding only: a section owns the gap above it, so two neighbours never add up and every
// section sits the same distance (--spacing-section) from the one before. The page's bottom gap,
// above the footer, is on <main> (pb-footer).
---

<section class:list={['pt-section', className]} {...rest}>
  <Container>
    <slot />
  </Container>
</section>
