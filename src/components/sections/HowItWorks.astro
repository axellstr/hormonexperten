---
import Seal from '../../assets/icons/seal.svg';
import { BOOKING_URL, type Locale } from '../../config';
import type { Home } from '../../lib/schemas';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Note from '../ui/Note.astro';
import RevealText from '../ui/RevealText.astro';
import RollText from '../ui/RollText.astro';
import Section from '../ui/Section.astro';
import BookScene from './how-scenes/BookScene.astro';
import CallScene from './how-scenes/CallScene.astro';
import FollowUpScene from './how-scenes/FollowUpScene.astro';

interface Props {
  lang: Locale;
  how: Home['how'];
  /** The doctor shown in the call and follow-up scenes. */
  doctor: string;
}

const { lang, how, doctor } = Astro.props;
---

<!-- The steps are a deck of cards: each one sticks below the header and the next slides over it
     while the one underneath sinks back (scripts/step-stack). Below lg the heading pins above the
     deck; from lg the whole intro stays beside it, with a step list that follows the card on top. -->
<Section id="how-it-works" aria-labelledby="how-title">
  <!-- Below lg the bottom padding, cancelled by the list's negative margin, ends the pinned
       heading's room where the deck's ends (--stack-release), so the two leave together. -->
  <div
    class="group/stack pb-(--stack-release) lg:grid lg:grid-cols-12 lg:gap-12 lg:pb-0 xl:gap-16"
    data-stack
  >
    <!-- From lg at least as tall as the stacked deck (set by the script); when it is taller, the
         deck's bottom margin (--stack-hold) gives it the room, so the two still leave together.
         Below lg it has no box of its own, so the heading can pin for the whole deck. -->
    <div
      class="contents lg:sticky lg:top-28 lg:col-span-5 lg:block lg:min-h-(--stack-span) lg:self-start"
      data-stack-column
    >
      <div class="group-data-pinned/stack:stack-head" data-stack-head>
        <Eyebrow>{how.eyebrow}</Eyebrow>
        <h2 id="how-title" class="mt-eyebrow max-w-3xl text-h2 text-ink">
          {how.title}
        </h2>
      </div>
      <p class="mt-heading hidden max-w-3xl text-lead text-ink/80 lg:block">{how.intro}</p>

      <!-- Where the reader is in the deck. The cards carry the same titles, so it is hidden
           from assistive tech; the line and dots only move with the script. -->
      <ol aria-hidden="true" class="relative mt-12 hidden space-y-6 lg:block">
        <span class="absolute start-3.75 top-4 bottom-0 w-0.5 bg-ink/10">
          <span class="stack-progress block h-full bg-coral" data-stack-rail></span>
        </span>
        {how.steps.map((step, index) => (
          <li class="group/marker relative flex items-center gap-4" data-stack-marker>
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-bg text-sm font-semibold text-text-muted tabular-nums ring-1 ring-ink/15 group-data-reached/marker:bg-coral-tint group-data-reached/marker:text-ink group-data-reached/marker:ring-coral motion-safe:transition-colors motion-safe:duration-300">
              {index + 1}
            </span>
            <span class="text-base font-medium text-text-muted group-data-current/marker:text-ink motion-safe:transition-colors motion-safe:duration-300">
              {step.title}
            </span>
          </li>
        ))}
      </ol>

      <div class="hidden lg:mt-10 lg:block">
        <p class="max-w-md text-base text-ink/80">{how.cta.body}</p>
        <Button href={BOOKING_URL} class="mt-action">
          <RollText text={how.cta.label} />
        </Button>
        <Note compact class="mt-8" title={how.note.title} body={how.note.body} />
      </div>
    </div>

    <!-- Equal rows, so every card in the deck is the same height. -->
    <ol
      class="stack-deck mt-10 -mb-(--stack-release) grid auto-rows-fr gap-6 lg:col-span-7 lg:mt-0 lg:mb-(--stack-hold) lg:gap-12"
      data-stack-list
    >
      {how.steps.map((step, index) => (
        <li
          class="group-data-stacked/stack:stack-card"
          style={`--stack-index: ${index}`}
          data-stack-card
        >
          <!-- A scene of the step (how-scenes) fills the band above the text, which sits on a
               panel inset at the bottom, its corners concentric with the card's. An aspect box
               shares the grid cell with the text (square below lg, 3:2 from lg), so the card
               grows taller only when the text needs the room. The scene is out of flow, so it
               never sizes the card; it has a compact strip for short bands and, for tall ones,
               a full picture framed like the panel (scene-band, how-scenes/SceneSpread). The band is also all that may tuck under the pinned
               heading. -->
          <div class="stack-face grid h-full grid-cols-1 overflow-clip rounded-panel bg-bg ring-1 ring-ink/5">
            <!-- The tint over an opaque base, so a card never shows the one under it. -->
            <div class="absolute inset-0 bg-ink/4"></div>
            <div class="col-start-1 row-start-1 aspect-square w-full lg:aspect-3/2"></div>
            <div class="col-start-1 row-start-1 flex flex-col">
              <div class="relative min-h-28 flex-1 scene-band" data-stack-media>
                <div class="absolute inset-0 flex items-center-safe justify-center px-3 pt-3 pb-0.5 md:px-6 lg:px-4 lg:pt-4">
                  {index === 0 && <BookScene lang={lang} labels={step.scene} />}
                  {index === 1 && <CallScene doctor={doctor} labels={step.scene} />}
                  {index === 2 && <FollowUpScene lang={lang} doctor={doctor} labels={step.scene} />}
                </div>
              </div>
              <div class="relative m-3 rounded-xl bg-bg p-5 md:p-6 lg:m-4 lg:rounded-lg lg:p-5 xl:p-6">
                <h3 class="flex items-center gap-3 text-h4 text-ink">
                  <span
                    class="relative flex size-[50px] shrink-0 items-center justify-center text-h3 tabular-nums"
                    aria-hidden="true"
                  >
                    <Seal class="absolute inset-0 size-full text-coral-tint" />
                    <span class="relative">{index + 1}</span>
                  </span>
                  {step.title}
                </h3>
                <p class="mt-label max-w-measure text-base text-ink/80">{step.body}</p>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>

  <!-- Below lg the intro and the booking button close the deck instead of opening it, so the
       steps follow the heading straight away. It sits outside the deck's box, so the pinned
       heading has left by the time it comes up. -->
  <div class="mt-12 md:mt-16 lg:hidden">
    <p class="max-w-2xl reveal-text text-h3 font-medium text-ink">
      <RevealText text={how.intro} />
    </p>
    <Button href={BOOKING_URL} class="mt-8 w-full sm:w-auto">
      <RollText text={how.cta.label} />
    </Button>
    <Note compact inline class="mt-6" title={how.note.title} body={how.note.body} />
  </div>
</Section>

<script>
  import '../../scripts/step-stack';
</script>
