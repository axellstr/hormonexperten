---
import { Picture } from 'astro:assets';
import { getImage } from '../../lib/assets';
import type { Home } from '../../lib/schemas';
import Eyebrow from '../ui/Eyebrow.astro';
import Note from '../ui/Note.astro';
import Placeholder from '../ui/Placeholder.astro';
import Section from '../ui/Section.astro';

interface Props {
  how: Home['how'];
}

const { how } = Astro.props;
---

<!-- The steps are a deck of cards: each one sticks below the header and the next slides over it
     while the one underneath sinks back (scripts/step-stack). Below lg the heading pins above the
     deck; from lg the whole intro stays beside it, with a step list that follows the card on top. -->
<Section id="how-it-works" aria-labelledby="how-title">
  <!-- Below lg the bottom padding, cancelled by the list's negative margin, ends the pinned
       heading's room where the deck's ends (--stack-release), so the two leave together. -->
  <div
    class="group/stack pb-(--stack-release) lg:grid lg:grid-cols-12 lg:gap-12 lg:pb-0 xl:gap-16"
    data-stack
  >
    <!-- From lg as tall as the stacked deck (set by the script), so the two leave together.
         Below lg it has no box of its own, so the heading can pin for the whole deck; that's
         also why the reveal groups sit on its children. -->
    <div class="contents lg:sticky lg:top-28 lg:col-span-5 lg:block lg:min-h-(--stack-span) lg:self-start">
      <div class="group-data-pinned/stack:stack-head" data-stack-head data-text-reveal>
        <Eyebrow data-reveal="0">{how.eyebrow}</Eyebrow>
        <h2 id="how-title" class="mt-4 max-w-3xl text-h2 text-ink" data-reveal="1">
          {how.title}
        </h2>
      </div>
      <p class="mt-5 max-w-3xl text-lead text-ink/80" data-text-reveal data-reveal="2">
        {how.intro}
      </p>

      <!-- Where the reader is in the deck. The cards carry the same titles, so it is hidden
           from assistive tech; the line and dots only move with the script. -->
      <ol aria-hidden="true" class="relative mt-12 hidden space-y-6 lg:block">
        <span class="absolute start-3.75 top-4 bottom-4 w-0.5 bg-ink/10">
          <span class="stack-progress block h-full bg-coral" data-stack-rail></span>
        </span>
        {how.steps.map((step, index) => (
          <li class="group/marker relative flex items-center gap-4" data-stack-marker>
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-bg text-sm font-semibold text-text-muted tabular-nums ring-1 ring-ink/15 group-data-reached/marker:bg-coral-tint group-data-reached/marker:text-ink group-data-reached/marker:ring-coral motion-safe:transition-colors motion-safe:duration-300">
              {index + 1}
            </span>
            <span class="text-base font-medium text-text-muted group-data-current/marker:text-ink motion-safe:transition-colors motion-safe:duration-300">
              {step.title}
            </span>
          </li>
        ))}
      </ol>
    </div>

    <!-- Equal rows, so every card in the deck is the same height. -->
    <ol
      class="mt-10 -mb-(--stack-release) grid auto-rows-fr gap-6 lg:col-span-7 lg:mt-0 lg:mb-0 lg:gap-12"
      data-stack-list
    >
      {how.steps.map((step, index) => (
        <li
          class="group-data-stacked/stack:stack-card"
          style={`--stack-index: ${index}`}
          data-stack-card
        >
          <div class="stack-face h-full overflow-hidden rounded-panel bg-surface ring-1 ring-ink/5">
            <div data-stack-media>
              {step.image ? (
                <Picture
                  src={getImage(step.image)}
                  alt={step.image_alt ?? ''}
                  formats={['avif', 'webp']}
                  widths={[480, 720, 1080]}
                  sizes="(min-width: 1440px) 800px, (min-width: 1024px) 55vw, 95vw"
                  class="aspect-5/2 w-full object-cover"
                />
              ) : (
                <Placeholder class="aspect-5/2" />
              )}
            </div>
            <div class="p-6 md:p-8 xl:p-10">
              <h3 class="text-h3 text-ink">
                <span class="text-text-muted tabular-nums" aria-hidden="true">
                  {`${index + 1}.`}
                </span>{' '}
                {step.title}
              </h3>
              <p class="mt-4 max-w-prose text-body text-ink/80">{step.body}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>

  <Note class="mt-10 lg:mt-16" title={how.note.title} body={how.note.body} />
</Section>

<script>
  import '../../scripts/step-stack';
</script>
