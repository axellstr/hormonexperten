---
import type { Locale } from '../../config';
import type { Service } from '../../lib/schemas';
import Section from '../ui/Section.astro';
import ServiceMenuCard from '../ui/ServiceMenuCard.astro';

interface Props {
  lang: Locale;
  title: string;
  items: Service[];
}

const { lang, title, items } = Astro.props;
---

{items.length > 0 && (
  <Section aria-labelledby="related-title">
    <h2 id="related-title" class="text-h2 text-ink">
      {title}
    </h2>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:mt-14 lg:grid-cols-3 lg:gap-6">
      {items.map((service) => (
        <li>
          <ServiceMenuCard
            lang={lang}
            service={service}
            sizes="(min-width: 1440px) 450px, (min-width: 1024px) 31vw, (min-width: 640px) 46vw, 92vw"
            class="h-56 md:h-64 xl:h-72"
          />
        </li>
      ))}
    </ul>
  </Section>
)}
