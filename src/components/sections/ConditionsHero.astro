---
import Connected from '../../assets/icons/connected.svg';
import Flame from '../../assets/icons/flame.svg';
import Thyroid from '../../assets/icons/thyroid.svg';
import Venus from '../../assets/icons/venus.svg';
import { BOOKING_URL } from '../../config';
import type { Conditions } from '../../lib/schemas';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';

// The same stroke icons as the landing, one per group. A down arrow read as a dropdown.
const icons: Record<string, typeof Venus> = {
  'hormones-cycle': Venus,
  metabolism: Flame,
  thyroid: Thyroid,
  'chronic-autoimmune': Connected,
};

interface Props {
  conditions: Conditions;
  /** The groups that have at least one visible page, with that count. */
  groups: { id: string; title: string; count: number }[];
  /** Set when the text falls back to another language than the page's. */
  contentLang?: string | undefined;
}

const { conditions, groups, contentLang } = Astro.props;
---

<!-- Sits below the floating header pill, like the other heroes. -->
<div class="mt-4 lg:mt-6" data-hero>
  <Container>
    <section
      aria-labelledby="conditions-title"
      class="overflow-hidden rounded-panel bg-surface px-6 pt-10 pb-10 md:px-12 lg:pt-14 lg:pb-14 xl:px-16"
    >
      <div class="grid items-end gap-10 lg:grid-cols-12 lg:gap-12 xl:gap-20">
        <div class="lg:col-span-8">
          <Eyebrow>{conditions.eyebrow}</Eyebrow>
          <h1
            id="conditions-title"
            lang={contentLang}
            class="mt-eyebrow max-w-3xl text-display text-ink"
          >
            {conditions.title}
          </h1>
          <p lang={contentLang} class="mt-heading max-w-measure text-lead text-ink/80">
            {conditions.intro}
          </p>
          <Button href={BOOKING_URL} class="mt-action">
            {conditions.cta}
          </Button>
        </div>

        <!-- Jump links to the groups below, so the overview reads as an index. -->
        <nav aria-label={conditions.groups_label} class="lg:col-span-4">
          <ul class="grid gap-2">
            {groups.map((group) => {
              const Icon = icons[group.id];
              return (
                <li>
                  <a
                    href={`#${group.id}`}
                    class="flex items-center gap-3 rounded-card bg-bg px-3 py-3 text-base font-medium text-ink ring-1 ring-ink/5 hover:ring-ink/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink motion-safe:transition-shadow"
                  >
                    {Icon && (
                      <span class="grid size-12 shrink-0 place-items-center rounded-full bg-coral-tint text-ink">
                        <Icon class="size-7" aria-hidden="true" />
                      </span>
                    )}
                    <span lang={contentLang} class="grow">
                      {group.title}
                    </span>
                    <span class="pe-1 text-sm text-ink/70 tabular-nums">{group.count}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      </div>
    </section>
  </Container>
</div>
