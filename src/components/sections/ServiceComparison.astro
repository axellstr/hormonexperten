---
import { isVisible, visible } from '../../lib/content';
import type { ServicePage } from '../../lib/schemas';
import Section from '../ui/Section.astro';
import ShapeMark from '../ui/ShapeMark.astro';

interface Props {
  comparison: NonNullable<ServicePage['comparison']>;
}

const { comparison } = Astro.props;
const rows = visible(comparison.rows);

type Value = (typeof rows)[number]['values'][number];
const text = (value: Value) =>
  value.more && isVisible(value.more) ? `${value.text}, ${value.more.text}` : value.text;

// One mark per column, in the order of `options`: bioidentical the smooth circle, conventional
// the scalloped seal (similar, but shaped differently). Same colour and size, so neither reads
// as the better one.
const shapes = ['circle', 'seal'] as const;
---

<!--
  A coral-tint panel: a heavy coral bar under the column heads and above the closing line, quiet
  ink hairlines between rows, terse values. Both options carry the same weight (the practice
  presents both as valid), so neither column is highlighted; each has its shape mark (ShapeMark)
  in its head, and on phones before every value, so a column can be told apart once its head has
  scrolled away.
  From md a real table; phones keep the two columns but put each row's label on its own line
  above its values. Only one version is displayed, so screen readers meet the table once.
  Pinning: from lg the heading and intro stay beside the table while it scrolls past. Below lg
  only the heading pins (How it Works' `stack-head`, following the header pill), and the intro
  and table scroll away under it; its wrapper is `contents` there, so the heading stays pinned
  until the table's end. `max-lg:` because from lg the whole column pins instead and the
  heading's band would only get in the way.
-->
<Section aria-labelledby="comparison-title">
  <div class="lg:grid lg:grid-cols-12 lg:items-start lg:gap-12 xl:gap-20">
    <div class="contents lg:sticky lg:top-28 lg:col-span-5 lg:block">
      <h2 id="comparison-title" class="max-w-3xl text-h2 text-ink max-lg:stack-head">
        {comparison.title}
      </h2>
      <p class="mt-heading max-w-measure text-lead text-ink/80">{comparison.lead}</p>
    </div>

    <div class="mt-intro rounded-card bg-coral-tint p-4 md:p-8 lg:col-span-7 lg:mt-0">
      <table class="hidden w-full table-fixed md:table">
        <colgroup>
          <col class="w-1/4" />
          <col />
          <col />
        </colgroup>
        <thead>
          <tr class="border-b-4 border-coral">
            <td />
            {comparison.options.map((option, index) => (
              <th scope="col" class="pe-6 pb-3 text-start text-h4 text-ink last:pe-0">
                <span class="flex items-center gap-2.5">
                  <ShapeMark shape={shapes[index]} />
                  {option}
                </span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-b border-ink/10 last:border-0">
              <th
                scope="row"
                class="py-3 pe-6 text-start align-top text-base font-semibold text-ink"
              >
                {row.label}
              </th>
              {row.values.map((value) => (
                <td class="py-3 pe-6 align-top text-base text-ink/80 last:pe-0">{text(value)}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>

      <div class="md:hidden">
        <div class="grid grid-cols-2 gap-x-4 border-b-4 border-coral pb-3" aria-hidden="true">
          {comparison.options.map((option, index) => (
            <p class="flex flex-col items-start gap-2 text-h4 text-ink">
              <ShapeMark shape={shapes[index]} />
              {option}
            </p>
          ))}
        </div>
        <ul>
          {rows.map((row) => (
            <li class="border-b border-ink/10 py-3 last:border-0">
              <h3 class="text-base font-semibold text-ink">{row.label}</h3>
              <dl class="mt-1 grid grid-cols-2 gap-x-4">
                {row.values.map((value, index) => (
                  <div>
                    <dt class="sr-only">{comparison.options[index]}</dt>
                    <dd class="text-base text-ink/80">
                      <ShapeMark
                        shape={shapes[index]}
                        size="sm"
                        class="relative -top-px me-1.5 align-middle"
                      />
                      {text(value)}
                    </dd>
                  </div>
                ))}
              </dl>
            </li>
          ))}
        </ul>
      </div>

      <p class="border-t-4 border-coral pt-4 text-base font-medium text-ink">
        {comparison.summary}
      </p>
    </div>
  </div>
</Section>
