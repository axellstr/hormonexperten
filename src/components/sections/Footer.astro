---
import Facebook from '../../assets/icons/facebook.svg';
import Instagram from '../../assets/icons/instagram.svg';
import Jameda from '../../assets/icons/jameda.svg';
import LinkedIn from '../../assets/icons/linkedin.svg';
import WhatsApp from '../../assets/icons/whatsapp.svg';
import type { Locale } from '../../config';
import { getLogo } from '../../lib/assets';
import { visible } from '../../lib/content';
import { format, localizeHref } from '../../lib/i18n';
import type { Site } from '../../lib/schemas';
import Container from '../ui/Container.astro';
import Logo from '../ui/Logo.astro';

interface Props {
  lang: Locale;
  site: Site;
}

const { lang, site } = Astro.props;
const { footer } = site;
const social = visible(footer.social);
const payments = visible(footer.payments);
const socialIcons = {
  linkedin: LinkedIn,
  instagram: Instagram,
  whatsapp: WhatsApp,
  facebook: Facebook,
  jameda: Jameda,
};
const link =
  'inline-flex rounded-field text-on-dark/70 motion-safe:transition-colors hover:text-on-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-dark';
---

<footer>
  <Container class="rounded-t-panel bg-footer pt-12 text-on-dark lg:px-12 lg:pt-14 xl:px-16">
    <div class="grid gap-12 header-desktop:flex header-desktop:justify-between header-desktop:gap-x-12">
      <div class="md:flex md:items-end md:justify-between md:gap-12 header-desktop:block header-desktop:w-92 header-desktop:shrink-0">
        <div class="max-w-md">
          <Logo variant="footer" />
          <p class="mt-6 text-body text-on-dark/70">{footer.blurb}</p>
        </div>
        {social.length > 0 && (
          <ul
            aria-label={footer.social_label}
            class="mt-8 flex shrink-0 flex-wrap justify-start gap-3 md:mt-0 header-desktop:mt-8"
          >
            {social.map((item) => {
              const Icon = socialIcons[item.icon];
              return (
                <li>
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex size-11 items-center justify-center rounded-full border border-on-dark/20 text-on-dark/80 motion-safe:transition-colors hover:border-coral hover:text-coral focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-dark"
                  >
                    <Icon class="size-6" aria-hidden="true" />
                    <span class="sr-only">{item.name}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        )}
      </div>

      <div class="grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-8 lg:grid-cols-4 header-desktop:min-w-0 header-desktop:flex-1 header-desktop:grid-flow-col header-desktop:auto-cols-auto header-desktop:grid-cols-none header-desktop:justify-end header-desktop:gap-x-8">
        {footer.columns.map((column, index) => (
          <nav
            class:list={[
              'min-w-0',
              // The first column (Contact) holds the email address: full width on phones so it
              // doesn't break mid-address.
              index === 0 && 'col-span-2 sm:col-span-1',
            ]}
            aria-labelledby={`footer-column-${index}`}
          >
            <h2 id={`footer-column-${index}`} class="text-eyebrow uppercase text-on-dark">
              {column.title}
            </h2>
            <ul class="mt-4 space-y-1 text-sm">
              {visible(column.items).map((item) => (
                <li class="flex min-h-7 items-center py-1 text-on-dark/70">
                  {item.href ? (
                    <a href={localizeHref(item.href, lang)} class:list={[link, 'wrap-anywhere']}>
                      {item.label}
                    </a>
                  ) : (
                    item.label
                  )}
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>

    <div class="mt-10 flex flex-col-reverse items-start gap-4 border-t border-on-dark/20 py-6 text-start md:mt-12 md:flex-row md:items-center md:justify-between md:gap-6 lg:mt-14">
      <p class="text-sm text-on-dark/70">
        {format(footer.copyright, { year: new Date().getFullYear() })}
      </p>
      {payments.length > 0 && (
        <ul aria-label={footer.payments_label} class="flex flex-wrap justify-start gap-3">
          {payments.map((payment) => {
            const logo = getLogo(payment.logo);
            return (
              <li class="flex h-8 w-12 items-center justify-center rounded-lg bg-on-dark px-1.5">
                <img
                  src={logo.src}
                  width={logo.width}
                  height={logo.height}
                  alt={payment.name}
                  loading="lazy"
                  decoding="async"
                  class="max-h-5 w-auto"
                />
              </li>
            );
          })}
        </ul>
      )}
    </div>
  </Container>
</footer>
