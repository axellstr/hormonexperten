---
import { Image, Picture } from 'astro:assets';
import { BOOKING_URL } from '../../config';
import {
  getImage,
  HERO_IMAGE_HEIGHT,
  HERO_IMAGE_SIZES,
  HERO_IMAGE_WIDTH,
  HERO_IMAGE_WIDTHS,
  PORTRAIT_QUALITY,
} from '../../lib/assets';
import { isVisible } from '../../lib/content';
import { format } from '../../lib/i18n';
import type { Home } from '../../lib/schemas';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import RollPhrase from '../ui/RollPhrase.astro';
import RollText from '../ui/RollText.astro';

interface Props {
  lang: import('../../config').Locale;
  hero: Home['hero'];
  reviewProfile: Home['review_profile'];
}

const { lang, hero, reviewProfile } = Astro.props;
const { trust, slides } = hero;

const ratingDisplay = reviewProfile.rating.toLocaleString(lang, {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});
const ratingText = format(trust.rating_label, {
  rating: ratingDisplay,
  max: reviewProfile.rating_max,
});

/** Affiliation marks above the booking CTA (same in every locale). */
const affiliations = [
  { file: 'hormon-netzwerk.png', alt: 'Hormon Netzwerk' },
  { file: 'daegfa.png', alt: 'DÄGfA' },
] as const;
---

<!-- Sits below the floating header pill rather than under it. -->
<div class="mt-4 lg:mt-6" data-hero>
  <Container>
    <div class="overflow-hidden rounded-panel bg-surface">
      <div class="grid items-center gap-6 px-4 pt-4 pb-8 md:gap-10 md:px-12 md:pt-12 md:pb-12 lg:min-h-hero-height lg:grid-cols-2 lg:gap-12 lg:ps-12 lg:pe-0 xl:gap-16 xl:ps-16 lg:pt-16 lg:pb-16">
        <!-- Below md the image and text share one 16px inset, closer than the 48px from md. -->
        <div>
          {isVisible(trust) && (
            <div class="mb-5">
              <p class="sr-only">
                {trust.items.join(' · ')}. {ratingText}.
              </p>

              <div data-hero-trust-cycler aria-hidden="true" class="text-sm text-ink/80">
                <span data-slot class="grid min-h-10 grid-cols-1 grid-rows-1 items-center">
                  <span data-index="0" data-roll class="col-start-1 row-start-1">
                    <RollPhrase text={trust.items[0]} />
                  </span>
                </span>
                <template data-pool>
                  {trust.items.map((item, index) => (
                    <span data-index={index} data-roll class="col-start-1 row-start-1">
                      <RollPhrase text={item} />
                    </span>
                  ))}
                  <span data-index={trust.items.length} data-roll class="col-start-1 row-start-1">
                    <RollPhrase text={ratingText} />
                  </span>
                </template>
              </div>
            </div>
          )}
          <div class="max-w-xl">
            <h1 class="text-display text-ink">{hero.title}</h1>
            <p class="mt-heading text-body text-ink/80 md:text-lead">{hero.subtitle}</p>
          </div>
          <ul class="mt-8 flex max-w-xl flex-wrap items-center gap-x-8 gap-y-4">
            {affiliations.map((item) => {
              const image = getImage(item.file);
              return (
                <li class="h-8 md:h-10">
                  <Image
                    src={image}
                    alt={item.alt}
                    width={image.width}
                    height={image.height}
                    class="h-full w-auto object-contain opacity-70"
                  />
                </li>
              );
            })}
          </ul>
          <Button href={BOOKING_URL} class="mt-action">
            <RollText text={hero.cta} />
          </Button>
        </div>

        <!-- Image first on mobile. The first slide is a plain image; the rest scroll-snap. -->
        <div class="order-first -me-4 md:-me-12 lg:order-none lg:me-0" data-carousel>
          <!-- The trailing spacer (a sixth of the track, less the gap before it) lets the last
               slide scroll all the way to the start like the others, instead of stopping short. -->
          <ul
            class="relative flex cursor-grab snap-x snap-mandatory gap-6 overflow-x-auto select-none scrollbar-none after:-ms-6 after:w-1/6 after:shrink-0 active:cursor-grabbing data-moving:snap-none"
            aria-label={hero.gallery_label}
            data-carousel-track
          >
            {slides.map((slide, index) => (
              <li class="w-5/6 shrink-0 snap-start hero-slide" data-hero-slide>
                {/* The second slide peeks in beside the first from the first paint, so it loads
                    with the page (at low priority) rather than lazily, after layout. */}
                <Picture
                  src={getImage(slide.image)}
                  alt={slide.image_alt}
                  formats={['avif']}
                  fallbackFormat="webp"
                  quality={PORTRAIT_QUALITY}
                  widths={HERO_IMAGE_WIDTHS}
                  width={HERO_IMAGE_WIDTH}
                  height={HERO_IMAGE_HEIGHT}
                  fit="cover"
                  position="top"
                  sizes={HERO_IMAGE_SIZES}
                  priority={index === 0}
                  loading={index < 2 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : 'low'}
                  class="aspect-7/6 w-full object-cover"
                />
              </li>
            ))}
          </ul>
          <!-- Invisible rather than hidden until a script runs, so the dots' row is reserved
               from the first paint and the images don't jump when it appears. -->
          {slides.length > 1 && (
            <div
              class="invisible mt-3 flex justify-center gap-1 pe-4 hero-dots md:pe-12 lg:pe-0"
              data-carousel-nav
            >
              {slides.map((_, index) => (
                <button
                  type="button"
                  class="group/dot grid size-6 cursor-pointer place-items-center rounded-full focus-visible:outline-2 focus-visible:outline-ink"
                  aria-label={format(hero.slide_label, { n: index + 1, total: slides.length })}
                  data-carousel-dot
                  data-active={index === 0 ? '' : undefined}
                  aria-current={index === 0 ? 'true' : undefined}
                >
                  <span class="size-2.5 rounded-full bg-text-muted group-data-active/dot:bg-ink" />
                </button>
              ))}
            </div>
          )}
        </div>
        <!-- Reveals each photo once it is decoded, in order (see hero-slide in global.css), and
             the dots with the first. Inline, so it starts as the photos arrive rather than after
             the page's bundled scripts; a photo that fails to load is revealed anyway. The reveal
             starts in an animation frame: started mid-parse, WebKit can fix its start time before
             the parser next pauses to render, and the first frame drawn is nearly its last. -->
        <script is:inline>
          {
            const root = document.currentScript.previousElementSibling;
            const nav = root.querySelector('[data-carousel-nav]');
            let previous = Promise.resolve();
            root.querySelectorAll('[data-hero-slide]').forEach((slide, index) => {
              slide.addEventListener('animationend', (event) => {
                if (event.animationName === 'hero-window')
                  slide.toggleAttribute('data-settled', true);
              });
              const img = slide.querySelector('img');
              const decoded = img?.decode ? img.decode().catch(() => {}) : undefined;
              previous = Promise.all([previous, decoded]).then(() =>
                requestAnimationFrame(() => {
                  slide.toggleAttribute('data-revealed', true);
                  if (index > 0 || !nav) return;
                  nav.classList.remove('invisible');
                  nav.toggleAttribute('data-revealed', true);
                }),
              );
            });
          }
        </script>
      </div>
    </div>
  </Container>
</div>

<script>
  import '../../scripts/carousel';
  import '../../scripts/hero-trust-cycler';
</script>
