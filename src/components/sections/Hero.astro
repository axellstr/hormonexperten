---
import { Picture } from 'astro:assets';
import Star from '../../assets/icons/star.svg';
import { BOOKING_URL } from '../../config';
import {
  getImage,
  HERO_IMAGE_HEIGHT,
  HERO_IMAGE_SIZES,
  HERO_IMAGE_WIDTH,
  HERO_IMAGE_WIDTHS,
} from '../../lib/assets';
import { isVisible } from '../../lib/content';
import { format } from '../../lib/i18n';
import type { Home } from '../../lib/schemas';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';

interface Props {
  hero: Home['hero'];
}

const { hero } = Astro.props;
const { trust, slides } = hero;
---

<!-- Sits below the floating header pill rather than under it. -->
<div class="mt-4 lg:mt-6" data-hero>
  <Container>
    <div class="overflow-hidden rounded-panel bg-surface">
      <div class="grid items-center gap-10 px-6 pt-6 pb-12 md:px-12 md:pt-12 lg:min-h-hero-height lg:grid-cols-2 lg:gap-12 lg:ps-12 lg:pe-0 xl:gap-16 xl:ps-16 lg:pt-16 lg:pb-16">
        <div data-text-reveal>
          {isVisible(trust) && (
            <div class="mb-5" data-reveal="0">
              <p class="sr-only">
                {trust.items.join(' · ')}. {format(trust.rating_label, { rating: trust.rating })}.
              </p>

              <div data-hero-trust-cycler aria-hidden="true" class="text-sm text-ink/80 md:hidden">
                <span
                  data-slot
                  class="grid min-h-10 grid-cols-1 grid-rows-1 items-center perspective-near"
                >
                  <span data-index="0" class="col-start-1 row-start-1">
                    {trust.items[0]}
                  </span>
                </span>
                <template data-pool>
                  {trust.items.map((item, index) => (
                    <span data-index={index} class="col-start-1 row-start-1">
                      {item}
                    </span>
                  ))}
                  <span
                    data-index={trust.items.length}
                    class="col-start-1 row-start-1 flex items-center gap-0.5"
                  >
                    {Array.from({ length: trust.rating }, () => (
                      <Star class="size-3" />
                    ))}
                  </span>
                </template>
              </div>

              <p
                aria-hidden="true"
                class="hidden flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink/80 md:flex"
              >
                {trust.items.map((item) => (
                  <span>
                    {item} <span>·</span>
                  </span>
                ))}
                <span class="flex gap-0.5">
                  {Array.from({ length: trust.rating }, () => (
                    <Star class="size-3" />
                  ))}
                </span>
              </p>
            </div>
          )}
          <h1 class="text-title text-ink md:text-display" data-reveal="1">
            {hero.title}
          </h1>
          <p class="mt-4 max-w-xl text-body text-ink/80 md:mt-5 md:text-lead" data-reveal="2">
            {hero.subtitle}
          </p>
          <Button href={BOOKING_URL} class="mt-8" data-reveal="3">
            {hero.cta}
          </Button>
        </div>

        <!-- Image first on mobile. The first slide is a plain image; the rest scroll-snap. -->
        <div class="order-first -me-6 md:-me-12 lg:order-none lg:me-0" data-carousel>
          <!-- The trailing spacer (a sixth of the track, less the gap before it) lets the last
               slide scroll all the way to the start like the others, instead of stopping short. -->
          <ul
            class="relative flex cursor-grab snap-x snap-mandatory gap-6 overflow-x-auto select-none scrollbar-none after:-ms-6 after:w-1/6 after:shrink-0 active:cursor-grabbing data-moving:snap-none"
            aria-label={hero.gallery_label}
            data-carousel-track
          >
            {slides.map((slide, index) => (
              <li class="w-5/6 shrink-0 snap-start">
                <Picture
                  src={getImage(slide.image)}
                  alt={slide.image_alt}
                  formats={['avif']}
                  fallbackFormat="webp"
                  widths={HERO_IMAGE_WIDTHS}
                  width={HERO_IMAGE_WIDTH}
                  height={HERO_IMAGE_HEIGHT}
                  fit="cover"
                  position="center"
                  sizes={HERO_IMAGE_SIZES}
                  priority={index === 0}
                  fetchpriority={index === 0 ? 'high' : 'low'}
                  class="aspect-7/6 w-full rounded-panel object-cover"
                />
              </li>
            ))}
          </ul>
          <!-- Invisible rather than hidden until the script runs, so the dots' row is reserved
               from the first paint and the images don't jump when it appears. -->
          {slides.length > 1 && (
            <div
              class="invisible mt-3 flex justify-center gap-1 pe-6 md:pe-12 lg:pe-0"
              data-carousel-nav
            >
              {slides.map((_, index) => (
                <button
                  type="button"
                  class="group/dot grid size-6 cursor-pointer place-items-center rounded-full focus-visible:outline-2 focus-visible:outline-ink"
                  aria-label={format(hero.slide_label, { n: index + 1, total: slides.length })}
                  data-carousel-dot
                  data-active={index === 0 ? '' : undefined}
                  aria-current={index === 0 ? 'true' : undefined}
                >
                  <span class="size-2.5 rounded-full bg-text-muted group-data-active/dot:bg-ink" />
                </button>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  </Container>
</div>

<script>
  import '../../scripts/carousel';
  import '../../scripts/hero-trust-cycler';
</script>
