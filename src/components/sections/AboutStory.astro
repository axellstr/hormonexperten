---
import ArrowEnd from '../../assets/icons/arrow-end.svg';
import Quote from '../../assets/icons/quote.svg';
import type { Locale } from '../../config';
import { isVisible, memberLang, textLang } from '../../lib/content';
import { localizeHref } from '../../lib/i18n';
import type { About, Team } from '../../lib/schemas';
import Eyebrow from '../ui/Eyebrow.astro';
import RevealText from '../ui/RevealText.astro';
import Section from '../ui/Section.astro';

interface Props {
  lang: Locale;
  story: About['story'];
  team: Team;
}

const { lang, story, team } = Astro.props;

// The quote is shown only while its author is on the team page; name and role come from there.
const member = team.members.find((item) => item.id === story.founder.member);
if (!member) throw new Error(`About story: unknown team member "${story.founder.member}"`);
const founder = isVisible(member) && isVisible(story.founder) ? member : undefined;
const profileHref =
  founder?.profile && isVisible(founder.profile)
    ? localizeHref(`/team/${founder.id}`, lang)
    : undefined;
// Untranslated text falls back to English; say so for screen readers.
const otherLang = (text: Locale) => (text === lang ? undefined : text);
const quoteLang = otherLang(textLang('about', lang, ['story', 'founder', 'quote']));
const roleLang = founder && otherLang(memberLang(lang, founder.id, 'role'));
---

<Section aria-labelledby="story-title">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-16 xl:gap-20">
    <div class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start">
      <Eyebrow>{story.eyebrow}</Eyebrow>
      <h2 id="story-title" class="mt-4 text-h2 text-ink">
        {story.title}
      </h2>
    </div>

    <div class="lg:col-span-7">
      <div class="max-w-prose space-y-6 text-body text-ink/80">
        {story.body.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      {founder && (
        <figure class="mt-12 rounded-panel bg-surface p-6 md:p-10 lg:mt-16 xl:p-12">
          <Quote class="size-10 text-coral lg:size-12" aria-hidden="true" />
          <blockquote class="mt-6" lang={quoteLang}>
            <p class="reveal-text text-h3 font-medium text-ink">
              <RevealText text={story.founder.quote} />
            </p>
          </blockquote>
          <figcaption class="mt-8 flex flex-col gap-5 border-t border-ink/10 pt-6 sm:flex-row sm:items-end sm:justify-between">
            <div class="border-s-2 border-coral ps-4">
              <p class="text-body font-medium text-ink">{founder.name}</p>
              <p lang={roleLang} class="mt-1 max-w-sm text-sm text-ink/70">
                {founder.role}
              </p>
            </div>
            {profileHref && (
              <a
                href={profileHref}
                class="group inline-flex shrink-0 items-center gap-2 self-start rounded-sm text-base font-semibold text-ink underline decoration-coral decoration-2 underline-offset-4 hover:decoration-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink motion-safe:transition-colors sm:self-auto"
              >
                {story.founder.link}
                <span class="sr-only">: {founder.name}</span>
                <ArrowEnd
                  class="size-5 shrink-0 group-hover:translate-x-0.5 motion-safe:transition-transform rtl:-scale-x-100"
                  aria-hidden="true"
                />
              </a>
            )}
          </figcaption>
        </figure>
      )}
    </div>
  </div>
</Section>
