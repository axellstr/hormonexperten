---
import ChevronEnd from '../../assets/icons/chevron-end.svg';
import Facebook from '../../assets/icons/facebook.svg';
import Instagram from '../../assets/icons/instagram.svg';
import Jameda from '../../assets/icons/jameda.svg';
import LinkedIn from '../../assets/icons/linkedin.svg';
import WhatsApp from '../../assets/icons/whatsapp.svg';
import { BOOKING_URL, type Locale } from '../../config';
import { getImage } from '../../lib/assets';
import { visible } from '../../lib/content';
import { localizeHref } from '../../lib/i18n';
import type { Site } from '../../lib/schemas';
import Button from '../ui/Button.astro';
import RollText from '../ui/RollText.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import LanguageSwitcher from '../ui/LanguageSwitcher.astro';
import Logo from '../ui/Logo.astro';
import Photo from '../ui/Photo.astro';
import Placeholder from '../ui/Placeholder.astro';
import ServiceMenuCard from '../ui/ServiceMenuCard.astro';

interface Props {
  lang: Locale;
  site: Site;
}

const { lang, site } = Astro.props;
const { nav, footer } = site;
const navItems = visible(nav.items);
const services = visible(site.services);
const social = visible(footer.social);
const socialIcons = {
  linkedin: LinkedIn,
  instagram: Instagram,
  whatsapp: WhatsApp,
  facebook: Facebook,
  jameda: Jameda,
};
// The menus show the first four as image cards and list the rest as text links beside them.
const featured = services.slice(0, 4);
const more = services.slice(4);
const moreLink =
  'rounded-sm text-base font-medium text-ink/80 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink motion-safe:transition-colors';
const allLink =
  'rounded-sm text-base font-semibold text-ink underline decoration-1 underline-offset-4 hover:decoration-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink';

/** The section a nav item points to, for the scroll-spy highlight. */
const sectionOf = (href: string) => href.split('#')[1] ?? '';

/** Whether a nav item is the current page (in-page section links never are). */
const here = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) =>
  !href.includes('#') && localizeHref(href, lang).replace(/\/$/, '') === here;
const servicesItem = navItems.find((item) => item.submenu);

// Without JS the hover background is on the link itself; with JS a sliding pill replaces it.
// Safari gives the pill its own GPU layer while it slides and draws that over the labels despite
// their z-index, so the labels get layers of their own (`transform-gpu`) to stay on top.
const navLink =
  'relative z-10 flex items-center gap-1 rounded-full px-3 py-2 text-sm font-medium tracking-wide whitespace-nowrap text-ink/80 uppercase hover:text-ink group-not-data-enhanced/track:hover:bg-coral-tint group-data-enhanced/track:transform-gpu focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink motion-safe:transition-colors';
// Mobile menu sheet: large rows with a round icon button at the end, like the service cards.
const sheetLink =
  'group/link flex w-full cursor-pointer list-none items-center justify-between gap-4 rounded-field py-4 text-h2 font-medium text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink md:py-5';
const sheetIcon =
  'grid size-11 shrink-0 place-items-center rounded-full bg-bg text-ink group-hover/link:bg-coral motion-safe:transition-colors motion-safe:duration-300';
// Sheet contents rise in one after another once the sheet has started to grow, and leave together
// at the same pace.
const sheetReveal =
  'group-data-closed/mobile:translate-y-3 group-data-closed/mobile:opacity-0 motion-safe:transition motion-safe:duration-300 motion-safe:ease-smooth';
const sheetDelay = [
  'motion-safe:group-not-data-closed/mobile:delay-100',
  'motion-safe:group-not-data-closed/mobile:delay-150',
  'motion-safe:group-not-data-closed/mobile:delay-200',
  'motion-safe:group-not-data-closed/mobile:delay-250',
  'motion-safe:group-not-data-closed/mobile:delay-300',
  'motion-safe:group-not-data-closed/mobile:delay-350',
];
---

<div data-header-sentinel aria-hidden="true" class="h-px -mb-px"></div>
<header class="group/header sticky top-0 z-40 origin-top pt-2 lg:pt-4" data-header>
  <!-- From 1440px the nav shows and the pill takes the full content width, so the longest
       languages (German, Greek) keep every nav label on one line. -->
  <Container class="max-w-header! xl:w-11/12 header-desktop:max-w-content! header-desktop:w-full">
    <!-- A floating pill. The end padding equals the end button's inset from the top and bottom
         (10px in the 64px phone pill, 14px from md), so it sits concentric in the rounded end. -->
    <div
      class="relative flex h-16 items-center justify-between gap-2 rounded-full bg-bg ps-4 pe-2.5 ring-1 ring-ink/0 group-data-scrolled/header:ring-ink/10 sm:gap-4 md:h-18 md:ps-6 md:pe-3.5 lg:h-20 lg:pe-4.5 xl:ps-8 motion-safe:transition-shadow"
      data-header-bar
    >
      <Logo href={localizeHref('/', lang)} label={nav.home} />

      <nav aria-label={nav.label} class="hidden header-desktop:block">
        <span
          aria-hidden="true"
          data-nav-indicator
          class="pointer-events-none absolute start-0 top-0 rounded-full bg-coral-tint opacity-0 motion-safe:transition-all motion-safe:duration-300 motion-safe:ease-out"
        ></span>
        <ul
          class="group/track flex items-center gap-0.5 rounded-full bg-bg/70 p-1 text-base font-medium whitespace-nowrap ring-1 ring-ink/0 group-data-scrolled/header:ring-ink/5 motion-safe:transition-shadow"
          data-nav-track
        >
          {navItems.map((item) =>
            item.submenu ? (
              <li>
                <details class="group/mega" data-menu data-menu-hover>
                  <!-- Click goes to the services overview; hover still opens the mega menu. -->
                  <summary class="list-none [&::-webkit-details-marker]:hidden">
                    <a
                      href={localizeHref(item.href, lang)}
                      class:list={[navLink, 'cursor-pointer']}
                      data-nav-item={sectionOf(item.href)}
                      aria-current={isCurrent(item.href) ? 'page' : undefined}
                    >
                      {item.label}
                      <!-- Each arm hinges at the chevron's tip, flattening into a single line. -->
                      <svg
                        viewBox="0 0 20 20"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="size-4 shrink-0 group-open/mega:group-not-data-closed/mega:-translate-y-0.5 motion-safe:transition-transform motion-safe:duration-300 motion-safe:ease-smooth"
                        aria-hidden="true"
                      >
                        <path
                          d="M4 7l6 6"
                          class="origin-bottom-right transform-fill group-open/mega:group-not-data-closed/mega:-rotate-45 motion-safe:transition-transform motion-safe:duration-300 motion-safe:ease-smooth"
                        />
                        <path
                          d="m10 13 6-6"
                          class="origin-bottom-left transform-fill group-open/mega:group-not-data-closed/mega:rotate-45 motion-safe:transition-transform motion-safe:duration-300 motion-safe:ease-smooth"
                        />
                      </svg>
                    </a>
                  </summary>

                  <!-- Moves as one piece, in step with the chevron: in and out the same way, over the
                       same 300ms on the same curve. While it fades out it lets the pointer through,
                       so passing over it can't bring it back. -->
                  <div
                    class="absolute inset-x-0 top-full pt-2 group-data-closed/mega:pointer-events-none group-data-closed/mega:-translate-y-1 group-data-closed/mega:opacity-0 motion-safe:transition motion-safe:duration-300 motion-safe:ease-smooth"
                    data-menu-panel
                  >
                    <div class="flex gap-3 rounded-panel bg-bg p-3">
                      <ul class="grid grow auto-cols-fr grid-flow-col gap-3">
                        {featured.map((service) => (
                          <li>
                            <ServiceMenuCard
                              lang={lang}
                              service={service}
                              sizes="300px"
                              nested
                              class="h-52 xl:h-60"
                            />
                          </li>
                        ))}
                      </ul>
                      <!-- The overview link is always there; any services past four are listed above it. -->
                      <div
                        class:list={[
                          'flex w-64 shrink-0 flex-col gap-6 rounded-xl bg-surface p-5 whitespace-normal',
                          more.length > 0 ? 'justify-between' : 'justify-end',
                        ]}
                      >
                        {more.length > 0 && (
                          <ul class="space-y-3">
                            {more.map((service) => (
                              <li>
                                <a href={localizeHref(service.href, lang)} class={moreLink}>
                                  {service.title}
                                </a>
                              </li>
                            ))}
                          </ul>
                        )}
                        <a
                          href={localizeHref(item.href, lang)}
                          class:list={[allLink, 'self-start']}
                        >
                          {nav.all_services}
                        </a>
                      </div>
                    </div>
                  </div>
                </details>
              </li>
            ) : (
              <li>
                <a
                  href={localizeHref(item.href, lang)}
                  class={navLink}
                  data-nav-item={sectionOf(item.href)}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ),
          )}
        </ul>
      </nav>

      <div class="flex items-center gap-2 md:gap-3">
        <LanguageSwitcher lang={lang} label={nav.language} class="hidden header-desktop:block" />
        <div class="hidden sm:block">
          <Button href={BOOKING_URL} size="sm" class="whitespace-nowrap">
            <RollText text={nav.book} />
          </Button>
        </div>

        <!--
          Mobile menu: a full-screen sheet that grows out of the header pill and slides back
          into it. The pill stays on top, so the logo, Book Now and this toggle (now "Close")
          never leave the screen. Without JS it is a plain <details> that opens instantly.
        -->
        <details class="group/mobile header-desktop:hidden" data-menu data-menu-sheet>
          <summary class="group/button flex size-11 cursor-pointer list-none items-center justify-center gap-2 rounded-full font-semibold text-ink hover:bg-coral-tint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink motion-safe:transition-colors sm:w-auto sm:ps-3 sm:pe-4">
            <!-- Two bars that meet in the middle and turn into a cross. -->
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              class="size-6 shrink-0"
              aria-hidden="true"
            >
              <path
                d="M5 9h14"
                class="origin-center transform-fill group-open/mobile:group-not-data-closed/mobile:translate-y-0.75 group-open/mobile:group-not-data-closed/mobile:rotate-45 motion-safe:transition-transform motion-safe:duration-300 motion-safe:ease-smooth"
              />
              <path
                d="M5 15h14"
                class="origin-center transform-fill group-open/mobile:group-not-data-closed/mobile:-translate-y-0.75 group-open/mobile:group-not-data-closed/mobile:-rotate-45 motion-safe:transition-transform motion-safe:duration-300 motion-safe:ease-smooth"
              />
            </svg>
            <span class="sr-only">{nav.menu}</span>
            <!-- Both labels share one grid cell, so the button keeps its width as they swap. -->
            <span class="hidden sm:inline-grid" aria-hidden="true">
              <span class="col-start-1 row-start-1 group-open/mobile:group-not-data-closed/mobile:-translate-y-1 group-open/mobile:group-not-data-closed/mobile:opacity-0 motion-safe:transition motion-safe:duration-300 motion-safe:ease-smooth">
                <RollText text={nav.menu} />
              </span>
              <span class="col-start-1 row-start-1 translate-y-1 opacity-0 group-open/mobile:group-not-data-closed/mobile:translate-y-0 group-open/mobile:group-not-data-closed/mobile:opacity-100 motion-safe:transition motion-safe:duration-300 motion-safe:ease-smooth">
                <RollText text={nav.close} />
              </span>
            </span>
          </summary>

          <!-- Sits behind the pill (-z-10 inside the header), covering the page. -->
          <div
            class="sheet scrollbar-none fixed inset-0 -z-10 flex flex-col overflow-y-auto overscroll-contain bg-surface pt-24 group-data-closed/mobile:sheet-collapsed lg:pt-32"
            data-menu-panel
          >
            <Container class="flex min-h-full max-w-header! grow flex-col xl:w-11/12 header-desktop:max-w-content! header-desktop:w-full">
              <!-- Inset like the pill's content, so the menu lines up under the logo.
                   On lg: row 1 is 1fr so the language row sits at the bottom of the sheet. -->
              <div class="flex grow flex-col px-4 pb-6 md:px-6 md:pb-10 lg:grid lg:grid-cols-12 lg:grid-rows-[1fr_auto] lg:gap-x-16 xl:px-8">
                <nav aria-label={nav.label} class="lg:col-span-5">
                  <ul class="space-y-1">
                    {navItems.map((item, index) => (
                      <li
                        class:list={[
                          sheetReveal,
                          sheetDelay[index],
                          // From md the services show as image cards instead.
                          item.submenu && 'md:hidden',
                        ]}
                      >
                        {item.submenu ? (
                          <details class="group/sub details-content:h-0 details-content:overflow-clip open:details-content:h-auto motion-safe:size-motion:details-content:transition-[height,content-visibility] motion-safe:size-motion:details-content:transition-discrete motion-safe:size-motion:details-content:duration-300 motion-safe:size-motion:details-content:ease-smooth">
                            <summary class={sheetLink}>
                              {item.label}
                              <span class={sheetIcon}>
                                <!-- Matches the FAQ and desktop navigation chevron animation. -->
                                <svg
                                  viewBox="0 0 20 20"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="1.5"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  class="size-6 opacity-80 group-open/sub:-translate-y-0.5 motion-safe:transition-transform motion-safe:duration-300 motion-safe:ease-smooth"
                                  aria-hidden="true"
                                >
                                  <path
                                    d="M4 7l6 6"
                                    class="origin-bottom-right transform-fill group-open/sub:-rotate-45 motion-safe:transition-transform motion-safe:duration-300 motion-safe:ease-smooth"
                                  />
                                  <path
                                    d="m10 13 6-6"
                                    class="origin-bottom-left transform-fill group-open/sub:rotate-45 motion-safe:transition-transform motion-safe:duration-300 motion-safe:ease-smooth"
                                  />
                                </svg>
                              </span>
                            </summary>
                            <ul
                              class="grid gap-2 pb-5 sm:grid-cols-2"
                              data-warm-media="(width < 48rem)"
                            >
                              {services.map((service) => (
                                <li>
                                  <a
                                    href={localizeHref(service.href, lang)}
                                    class="group/row flex items-center gap-3 rounded-card bg-bg p-2 pe-4 hover:bg-coral-tint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink motion-safe:transition-colors"
                                  >
                                    {service.image ? (
                                      <Photo
                                        src={getImage(service.image)}
                                        alt={service.image_alt}
                                        widths={[96, 144]}
                                        sizes="48px"
                                        pictureAttributes={{ class: 'shrink-0' }}
                                        class="size-12 rounded-2xl object-cover"
                                      />
                                    ) : (
                                      <Placeholder class="size-12 shrink-0 overflow-hidden rounded-2xl text-center" />
                                    )}
                                    <span class="text-base leading-snug font-medium text-ink">
                                      {service.title}
                                    </span>
                                    <ChevronEnd
                                      class="ms-auto size-5 shrink-0 text-ink/70 group-hover/row:translate-x-0.5 motion-safe:transition-transform rtl:-scale-x-100 rtl:group-hover/row:-translate-x-0.5"
                                      aria-hidden="true"
                                    />
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </details>
                        ) : (
                          <a
                            href={localizeHref(item.href, lang)}
                            class={sheetLink}
                            aria-current={isCurrent(item.href) ? 'page' : undefined}
                          >
                            {item.label}
                            <span class={sheetIcon}>
                              <ChevronEnd
                                class="size-5 group-hover/link:translate-x-0.5 motion-safe:transition-transform motion-safe:duration-300 rtl:-scale-x-100 rtl:group-hover/link:-translate-x-0.5"
                                aria-hidden="true"
                              />
                            </span>
                          </a>
                        )}
                      </li>
                    ))}
                  </ul>
                </nav>

                {servicesItem && (
                  <div
                    class:list={[
                      'hidden md:mt-12 md:block lg:col-span-7 lg:mt-0 lg:pt-5',
                      sheetReveal,
                      sheetDelay[2],
                    ]}
                    data-warm-media="(width >= 48rem)"
                  >
                    <Eyebrow id="sheet-services">{servicesItem.label}</Eyebrow>
                    <ul aria-labelledby="sheet-services" class="mt-4 grid grid-cols-2 gap-3">
                      {featured.map((service) => (
                        <li>
                          <ServiceMenuCard
                            lang={lang}
                            service={service}
                            sizes="(min-width: 1280px) 25vw, (min-width: 1024px) 28vw, 45vw"
                            class="h-40 lg:h-44 xl:h-52"
                          />
                        </li>
                      ))}
                    </ul>
                    <div class="mt-5 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-4">
                      {more.length > 0 && (
                        <ul class="flex flex-wrap gap-x-6 gap-y-2">
                          {more.map((service) => (
                            <li>
                              <a href={localizeHref(service.href, lang)} class={moreLink}>
                                {service.title}
                              </a>
                            </li>
                          ))}
                        </ul>
                      )}
                      <a href={localizeHref(servicesItem.href, lang)} class={allLink}>
                        {nav.all_services}
                      </a>
                    </div>
                  </div>
                )}

                <div
                  class:list={[
                    'mt-auto space-y-6 pt-10 lg:col-span-12 lg:col-start-1',
                    sheetReveal,
                    sheetDelay[4],
                  ]}
                >
                  <!-- Phones: language above socials. From sm they sit in a row, languages at the end. -->
                  <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between sm:gap-10">
                    {social.length > 0 && (
                      <div>
                        <Eyebrow id="sheet-socials">{nav.socials}</Eyebrow>
                        <ul aria-labelledby="sheet-socials" class="mt-3 flex flex-wrap gap-2">
                          {social.map((item) => {
                            const Icon = socialIcons[item.icon];
                            return (
                              <li>
                                <a
                                  href={item.href}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class="grid size-12 place-items-center rounded-full bg-bg text-ink hover:bg-coral-tint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink motion-safe:transition-colors"
                                >
                                  <Icon class="size-5" aria-hidden="true" />
                                  <span class="sr-only">{item.name}</span>
                                </a>
                              </li>
                            );
                          })}
                        </ul>
                      </div>
                    )}
                    <LanguageSwitcher
                      lang={lang}
                      label={nav.language}
                      inline
                      class="order-first shrink-0 sm:order-none"
                    />
                  </div>
                  <Button href={BOOKING_URL} class="w-full sm:hidden">
                    {nav.book}
                  </Button>
                </div>
              </div>
            </Container>
          </div>
        </details>
      </div>
    </div>
  </Container>
</header>

<script>
  import '../../scripts/header';
</script>
