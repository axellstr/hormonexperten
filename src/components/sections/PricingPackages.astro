---
import Check from '../../assets/icons/check.svg';
import ChevronEnd from '../../assets/icons/chevron-end.svg';
import MessageCircle from '../../assets/icons/message-circle.svg';
import Microscope from '../../assets/icons/microscope.svg';
import Pill from '../../assets/icons/pill.svg';
import Stethoscope from '../../assets/icons/stethoscope.svg';
import { BOOKING_URL, type Locale } from '../../config';
import { visible } from '../../lib/content';
import type { Pricing } from '../../lib/schemas';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Section from '../ui/Section.astro';

interface Props {
  lang: Locale;
  pricing: Pricing;
}

const { lang, pricing } = Astro.props;
const packages = visible(pricing.packages);
const notes = visible(pricing.notes.items);
const icons = {
  microscope: Microscope,
  pill: Pill,
  stethoscope: Stethoscope,
  'message-circle': MessageCircle,
};

// "€180" in English, "180 €" in German, Greek and Russian.
const euros = new Intl.NumberFormat(lang, {
  style: 'currency',
  currency: 'EUR',
  maximumFractionDigits: 0,
});

// The time bars share one scale: the package with the most doctor time fills its card's width.
const minutes = (sessions: number[]) => sessions.reduce((sum, item) => sum + item, 0);
const longest = Math.max(...packages.map((item) => minutes(item.sessions)));
const label = 'text-sm font-medium text-ink/70';
---

<!--
  Four warm cards side by side, as in the Figma pricing frame, two by two on tablets. Each card is
  a subgrid of the row, so titles, prices, "Best for" and the booking buttons line up across it
  however long a title or list runs (a button whose label wraps makes the whole row's buttons
  that tall). Under the price, a bar draws the package's doctor time to scale (one segment per
  appointment), so the packages compare at a glance; the line under it says the same in words.
  Phones: the cards are slides in a swipeable row (the hero's carousel.ts), each a full card with
  the next one peeking in, and the price list above is its index: a tap glides to that card, and
  the card in view marks its price. Without the script the list jumps to the card.
-->
<Section aria-labelledby="pricing-title">
  <div class="grid gap-heading lg:grid-cols-12 lg:items-end lg:gap-12 xl:gap-20">
    <div class="lg:col-span-7">
      <Eyebrow>{pricing.eyebrow}</Eyebrow>
      <h1 id="pricing-title" class="mt-eyebrow max-w-3xl text-display text-ink">
        {pricing.title}
      </h1>
    </div>
    <p class="max-w-measure text-lead text-ink/80 lg:col-span-5">{pricing.intro}</p>
  </div>

  <div data-carousel>
    <!-- Phones only: every price at a glance, and the slider's index. -->
    <nav aria-label={pricing.eyebrow} class="mt-action md:hidden" data-carousel-nav>
      <ul class="grid gap-2">
        {packages.map((item) => (
          <li>
            <a
              href={`#package-${item.id}`}
              class="group flex items-center gap-4 rounded-card bg-surface px-5 py-4 text-base font-medium text-ink hover:bg-coral-tint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink data-active:bg-coral-tint motion-safe:transition-colors"
              data-carousel-dot
            >
              <span class="grow">{item.title}</span>
              <span class="text-ink/70">{euros.format(item.price)}</span>
              <ChevronEnd
                class="size-5 shrink-0 group-hover:translate-x-0.5 motion-safe:transition-transform rtl:-scale-x-100"
                aria-hidden="true"
              />
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Below md a scroll-snap row reaching the screen edges; from md the card grid. -->
    <ul
      class="relative -mx-4 mt-intro flex snap-x snap-mandatory scroll-ps-4 gap-3 overflow-x-auto px-4 scrollbar-none data-moving:snap-none md:mx-0 md:grid md:grid-cols-2 md:gap-4 md:overflow-visible md:px-0 lg:gap-6 xl:grid-cols-4"
      data-carousel-track
    >
      {packages.map((item) => (
        <li
          id={`package-${item.id}`}
          class="flex w-11/12 shrink-0 snap-start flex-col rounded-card bg-surface p-6 md:row-span-6 md:grid md:w-auto md:grid-rows-subgrid md:gap-y-0 md:p-8 xl:p-6 2xl:p-8"
        >
          <p class="self-start justify-self-start rounded-full bg-bg px-3 py-1 text-sm font-medium text-ink hyphens-none">
            {item.kind}
          </p>

          <h2 class="mt-5 text-h3 text-ink">{item.title}</h2>

          <div class="mt-6">
            <p class="flex flex-wrap items-baseline gap-x-2">
              <span class="text-h2 text-ink">{euros.format(item.price)}</span>
              <span class="text-sm text-ink/70">{item.price_note}</span>
            </p>
            <div
              class="mt-5 flex h-1.5 gap-1"
              style={`width: ${(minutes(item.sessions) / longest) * 100}%`}
              aria-hidden="true"
            >
              {item.sessions.map((length) => (
                <span class="rounded-full bg-coral" style={`flex: ${length} 1 0%`} />
              ))}
            </div>
            <p class="mt-3 text-sm text-ink/70 tabular-nums">{item.time}</p>
          </div>

          <div class="mt-6 border-t border-ink/10 pt-6">
            <h3 class={label}>{pricing.labels.best_for}</h3>
            <p class="mt-label text-base text-ink">{item.best_for}</p>
          </div>

          <div class="mt-6 mb-8 md:mb-0">
            <h3 class={label}>{pricing.labels.included}</h3>
            <ul class="mt-3 space-y-3">
              {item.included.map((line) => (
                <li class="flex gap-3 text-base text-ink/80">
                  <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-coral-tint text-ink">
                    <Check class="size-3.5" aria-hidden="true" />
                  </span>
                  {line}
                </li>
              ))}
            </ul>
          </div>

          <!-- Slides share the tallest card's height, so the button sits at the bottom of each. -->
          <Button href={BOOKING_URL} size="full" class="mt-auto md:mt-8">
            {item.cta}
          </Button>
        </li>
      ))}
    </ul>
  </div>

  <!-- The small print, set as readable as the cards: what the prices don't cover. -->
  {notes.length > 0 && (
    <section
      aria-labelledby="pricing-notes-title"
      class="mt-12 grid gap-6 rounded-card p-6 ring-1 ring-ink/10 md:p-8 lg:mt-16 lg:grid-cols-12 lg:gap-12 xl:p-10"
    >
      <h2 id="pricing-notes-title" class="text-h4 text-ink lg:col-span-3">
        {pricing.notes.title}
      </h2>
      <ul class="grid gap-x-12 gap-y-6 md:grid-cols-2 lg:col-span-9">
        {notes.map((note) => {
          const Icon = icons[note.icon];
          return (
            <li class="flex items-start gap-4">
              <span class="grid size-10 shrink-0 place-items-center rounded-full bg-coral-tint text-ink">
                <Icon class="size-5" aria-hidden="true" />
              </span>
              <p class="max-w-measure pt-2 text-body text-ink/80">{note.text}</p>
            </li>
          );
        })}
      </ul>
    </section>
  )}
</Section>

<script>
  import '../../scripts/carousel';
</script>
