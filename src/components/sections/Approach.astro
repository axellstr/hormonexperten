---
import type { Locale } from '../../config';
import { IMAGE_QUALITY, getImage } from '../../lib/assets';
import { localizeHref } from '../../lib/i18n';
import type { Home } from '../../lib/schemas';
import Button from '../ui/Button.astro';
import Photo from '../ui/Photo.astro';
import RollText from '../ui/RollText.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Panel from '../ui/Panel.astro';
import RevealText from '../ui/RevealText.astro';
import Section from '../ui/Section.astro';

interface Props {
  lang: Locale;
  approach: Home['approach'];
}

const { lang, approach } = Astro.props;
---

<Section id="approach" aria-labelledby="approach-title">
  <!--
    The photo sits one frame gap from the panel's edge at every width, so the panel's corners nest
    round it. On desktop it fills the row's height, so the gap holds when the text is the taller
    column; the text keeps its own, larger padding.
  -->
  <Panel frame class="grid gap-6 md:grid-cols-2 md:gap-12 xl:gap-16">
    <div class="unveil aspect-4/3 w-full overflow-hidden rounded-panel md:aspect-7/6 md:self-stretch">
      <Photo
        quality={IMAGE_QUALITY}
        src={getImage(approach.image)}
        alt={approach.image_alt}
        widths={[480, 720, 960, 1300]}
        sizes="(min-width: 1440px) 640px, (min-width: 768px) 45vw, 90vw"
        class="unveil-photo size-full object-cover object-top"
      />
    </div>
    <div class="reveal-text pb-6 md:self-center md:px-6 md:py-6 md:ps-0 xl:py-14 xl:pe-14">
      <Eyebrow>{approach.eyebrow}</Eyebrow>
      <h2 id="approach-title" class="mt-eyebrow text-h2 text-ink">
        <RevealText text={approach.title} to={0.55} />
      </h2>
      <p class="mt-heading max-w-measure text-body text-ink/80">
        <RevealText text={approach.body} from={0.35} />
      </p>
      <Button href={localizeHref(approach.cta.href, lang)} class="mt-action">
        <RollText text={approach.cta.label} />
      </Button>
    </div>
  </Panel>
</Section>
