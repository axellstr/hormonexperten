---
import { Picture } from 'astro:assets';
import ArrowEnd from '../../assets/icons/arrow-end.svg';
import type { Locale } from '../../config';
import { getImage } from '../../lib/assets';
import { isVisible, memberLang, visible } from '../../lib/content';
import { localizeHref } from '../../lib/i18n';
import type { Team } from '../../lib/schemas';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Placeholder from '../ui/Placeholder.astro';
import Section from '../ui/Section.astro';

interface Props {
  lang: Locale;
  team: Team;
  /** Label of the link to the team page. */
  more: string;
}

const { lang, team, more } = Astro.props;
const members = visible(team.members).map((member) => ({
  ...member,
  href:
    member.profile && isVisible(member.profile)
      ? localizeHref(`/team/${member.id}`, lang)
      : undefined,
  roleLang: memberLang(lang, member.id, 'role'),
}));
const photo = 'aspect-4/5 w-full object-cover object-top';
---

<!-- The team in brief: a compact card per doctor, the full portraits are on the team page. -->
{members.length > 0 && (
  <Section id="team" aria-labelledby="team-title">
    <div class="flex flex-col items-start gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <Eyebrow>{team.eyebrow}</Eyebrow>
        <h2 id="team-title" class="mt-eyebrow max-w-3xl text-h2 text-ink">
          {team.title}
        </h2>
      </div>
      <Button href={localizeHref('/team', lang)} variant="secondary" class="shrink-0">
        {more}
      </Button>
    </div>

    <ul class="mt-10 grid gap-4 lg:mt-14 lg:grid-cols-2 lg:gap-6">
      {members.map((member) => {
        const Frame = member.href ? 'a' : 'div';
        return (
          <li>
            <!--
              Phones: photo and name side by side, role and link across the card below them.
              From sm: photo beside a text column, as one row.
            -->
            <Frame
              href={member.href}
              class:list={[
                'group grid h-full grid-cols-3 items-center gap-4 rounded-panel p-3 pb-5 ring-1 ring-ink/10 sm:flex sm:gap-8 sm:pb-3 sm:pe-8',
                member.href &&
                  'hover:bg-surface hover:ring-ink/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink motion-safe:transition',
              ]}
            >
              <div class="overflow-hidden rounded-card bg-surface sm:w-40 sm:shrink-0">
                {member.image ? (
                  <Picture
                    src={getImage(member.image)}
                    alt={member.image_alt ?? ''}
                    formats={['avif', 'webp']}
                    widths={[160, 240, 320, 480]}
                    sizes="(min-width: 640px) 160px, 100px"
                    class:list={[
                      photo,
                      member.href &&
                        'group-hover:scale-105 motion-safe:transition-transform motion-safe:duration-700 motion-safe:ease-out',
                    ]}
                  />
                ) : (
                  <Placeholder class={photo} />
                )}
              </div>
              <div class="contents sm:block sm:min-w-0 sm:py-2">
                <h3 class="col-span-2 text-h3 text-ink">{member.name}</h3>
                <div class="col-span-3 px-2 sm:px-0">
                  <p
                    lang={member.roleLang === lang ? undefined : member.roleLang}
                    class="text-base text-ink/70 sm:mt-2"
                  >
                    {member.role}
                  </p>
                  {member.href && (
                    <span class="mt-4 inline-flex items-center gap-2 text-base font-semibold text-ink underline decoration-coral decoration-2 underline-offset-4 group-hover:decoration-ink motion-safe:transition-colors">
                      {team.learn_more}
                      <ArrowEnd
                        class="size-5 shrink-0 group-hover:translate-x-0.5 motion-safe:transition-transform rtl:-scale-x-100"
                        aria-hidden="true"
                      />
                    </span>
                  )}
                </div>
              </div>
            </Frame>
          </li>
        );
      })}
    </ul>
  </Section>
)}
