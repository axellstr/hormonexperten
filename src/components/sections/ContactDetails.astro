---
import ArrowEnd from '../../assets/icons/arrow-end.svg';
import Clock from '../../assets/icons/clock.svg';
import ShieldCheck from '../../assets/icons/shield-check.svg';
import type { Locale } from '../../config';
import { visible } from '../../lib/content';
import { localizeHref } from '../../lib/i18n';
import type { Contact } from '../../lib/schemas';
import Section from '../ui/Section.astro';

interface Props {
  lang: Locale;
  details: Contact['details'];
}

const { lang, details } = Astro.props;
const { hours, privacy } = details;
const rows = visible(hours.rows);

const card = 'flex flex-col rounded-card bg-surface p-6 md:p-8 xl:p-10';
const icon = 'grid size-12 shrink-0 place-items-center rounded-full bg-coral-tint text-ink';
const more =
  'group mt-auto inline-flex items-center gap-2 self-start rounded-sm pt-6 text-base font-semibold text-ink underline decoration-coral decoration-2 underline-offset-4 hover:decoration-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink motion-safe:transition-colors';
const arrow =
  'size-5 shrink-0 group-hover:translate-x-0.5 motion-safe:transition-transform rtl:-scale-x-100';
---

<Section aria-labelledby="details-title">
  <h2 id="details-title" class="text-h2 text-ink">
    {details.title}
  </h2>

  <!-- Two cards side by side from tablets. The practice address is only in the Impressum and the
       Privacy Policy, at the practice's request (14 Oct 2026). -->
  <div class="mt-intro grid gap-4 md:grid-cols-2 lg:gap-6">
    <section aria-labelledby="hours-title" class={card}>
      <span class={icon}>
        <Clock class="size-6" aria-hidden="true" />
      </span>
      <h3 id="hours-title" class="mt-6 text-h4 text-ink">
        {hours.title}
      </h3>
      <dl class="mt-label divide-y divide-ink/10">
        {rows.map((row) => (
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3 first:pt-0">
            <dt class="text-body text-ink/80">{row.days}</dt>
            <dd class="text-body font-medium text-ink tabular-nums">{row.time}</dd>
          </div>
        ))}
      </dl>
      {hours.note && <p class="mt-auto pt-6 text-sm text-ink/70">{hours.note}</p>}
    </section>

    <section aria-labelledby="privacy-title" class={card}>
      <span class={icon}>
        <ShieldCheck class="size-6" aria-hidden="true" />
      </span>
      <h3 id="privacy-title" class="mt-6 text-h4 text-ink">
        {privacy.title}
      </h3>
      <p class="mt-label max-w-measure text-body text-ink/80">{privacy.body}</p>
      <a href={localizeHref(privacy.link.href, lang)} class={more}>
        {privacy.link.label}
        <ArrowEnd class={arrow} aria-hidden="true" />
      </a>
    </section>
  </div>
</Section>
