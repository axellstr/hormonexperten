---
import BookOpen from '../../assets/icons/book-open.svg';
import MessageCircle from '../../assets/icons/message-circle.svg';
import Sliders from '../../assets/icons/sliders.svg';
import Sprout from '../../assets/icons/sprout.svg';
import type { Profile } from '../../lib/schemas';
import Eyebrow from '../ui/Eyebrow.astro';
import Section from '../ui/Section.astro';

interface Props {
  mission: NonNullable<Profile['mission']>;
}

const { mission } = Astro.props;
const icons = {
  sprout: Sprout,
  'message-circle': MessageCircle,
  'book-open': BookOpen,
  sliders: Sliders,
};
---

<Section aria-labelledby="mission-title">
  <div class="grid gap-6 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <Eyebrow>{mission.eyebrow}</Eyebrow>
      <h2 id="mission-title" class="mt-4 text-h2 text-ink">
        {mission.title}
      </h2>
    </div>
    <p class="max-w-prose text-lead text-ink/80 lg:col-span-7 lg:pt-12">{mission.body}</p>
  </div>

  {mission.values.length > 0 && (
    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-16 lg:gap-6 xl:grid-cols-4">
      {mission.values.map((value) => {
        const Icon = icons[value.icon];
        return (
          <li class="rounded-card bg-surface p-6 motion-safe:reveal md:p-8">
            <span class="grid size-12 place-items-center rounded-full bg-coral-tint text-ink">
              <Icon class="size-6" aria-hidden="true" />
            </span>
            <h3 class="mt-6 text-h4 text-ink">{value.title}</h3>
            <p class="mt-2 text-base text-ink/80">{value.body}</p>
          </li>
        );
      })}
    </ul>
  )}
</Section>
