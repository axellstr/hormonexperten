---
import type { Locale } from '../../config';
import { IMAGE_QUALITY, getImage } from '../../lib/assets';
import { isVisible, memberLang, visible } from '../../lib/content';
import { localizeHref } from '../../lib/i18n';
import type { Team } from '../../lib/schemas';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Photo from '../ui/Photo.astro';
import Placeholder from '../ui/Placeholder.astro';
import Section from '../ui/Section.astro';

interface Props {
  lang: Locale;
  team: Team;
}

const { lang, team } = Astro.props;
const members = await Promise.all(
  visible(team.members).map(async (member) => ({
    ...member,
    href:
      member.profile && isVisible(member.profile)
        ? localizeHref(`/team/${member.id}`, lang)
        : undefined,
    roleLang: await memberLang(lang, member.id, 'role'),
  })),
);
---

<Section aria-labelledby="team-title" class="pt-16! md:pt-12!">
  <Eyebrow>{team.eyebrow}</Eyebrow>
  <h1 id="team-title" class="mt-eyebrow max-w-4xl text-display text-ink">
    {team.title}
  </h1>

  <ul class="mt-intro grid gap-14 md:max-w-4xl md:grid-cols-2 md:gap-8 xl:gap-12">
    {members.map((member, index) => {
      // The photo repeats the button's link for pointer users; keyboards and screen readers skip it.
      const Frame = member.href ? 'a' : 'div';
      return (
        <li class="group flex flex-col">
          <Frame
            href={member.href}
            tabindex={member.href ? -1 : undefined}
            aria-hidden={member.href ? 'true' : undefined}
            class="block overflow-hidden rounded-panel bg-surface"
          >
            {member.image ? (
              <Photo
                quality={IMAGE_QUALITY}
                src={getImage(member.image)}
                alt={member.image_alt ?? ''}
                widths={[480, 720, 960, 1300]}
                sizes="(min-width: 960px) 432px, (min-width: 768px) 45vw, 90vw"
                priority={index === 0}
                class:list={[
                  'aspect-7/6 w-full object-cover object-top',
                  member.href &&
                    'group-hover:scale-105 motion-safe:transition-transform motion-safe:duration-700 motion-safe:ease-out',
                ]}
              />
            ) : (
              <Placeholder class="aspect-7/6 w-full" />
            )}
          </Frame>
          <h2 class="mt-8 text-h2 text-ink">{member.name}</h2>
          <p
            lang={member.roleLang === lang ? undefined : member.roleLang}
            class="mt-heading text-lead text-ink/80"
          >
            {member.role}
          </p>
          {member.href && (
            <Button href={member.href} class="mt-action self-start">
              {team.learn_more}
              <span class="sr-only">: {member.name}</span>
            </Button>
          )}
        </li>
      );
    })}
  </ul>
</Section>
