---
import { Picture } from 'astro:assets';
import { getImage } from '../../lib/assets';
import type { Conditions } from '../../lib/schemas';
import Placeholder from '../ui/Placeholder.astro';
import Section from '../ui/Section.astro';

interface Props {
  coCare: Conditions['co_care'];
  /** Set when the text falls back to another language than the page's. */
  contentLang?: string | undefined;
}

const { coCare, contentLang } = Astro.props;
---

<!-- For patients already seeing a gynaecologist: their care stays where it is.
     From md the photo column takes the text row's height and stays square. -->
<Section spacing="compact" aria-labelledby="co-care-title">
  <div
    class="grid items-center gap-6 md:grid-cols-[auto_minmax(0,1fr)] md:items-stretch md:gap-8"
    lang={contentLang}
  >
    <div class="aspect-square w-full max-w-48 justify-self-start overflow-hidden rounded-panel md:h-full md:w-auto md:max-w-none">
      {coCare.image ? (
        <Picture
          src={getImage(coCare.image)}
          alt={coCare.image_alt}
          formats={['avif', 'webp']}
          widths={[192, 288, 384, 480]}
          sizes="(min-width: 768px) 160px, 192px"
          class="size-full object-cover"
        />
      ) : (
        <Placeholder class="size-full" />
      )}
    </div>
    <div class="min-w-0 self-center">
      <h2 id="co-care-title" class="text-h3 text-ink">
        {coCare.title}
      </h2>
      <p class="mt-subheading max-w-measure text-body text-ink/80">{coCare.body}</p>
    </div>
  </div>
</Section>
