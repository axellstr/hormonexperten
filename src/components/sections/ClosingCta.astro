---
import { BOOKING_URL } from '../../config';
import type { Home } from '../../lib/schemas';
import Button from '../ui/Button.astro';
import RollPhrase from '../ui/RollPhrase.astro';
import RollText from '../ui/RollText.astro';
import Section from '../ui/Section.astro';

interface Props {
  closing: Omit<Home['closing'], 'body' | 'info'> & {
    body?: string | undefined;
    info?: string[] | undefined;
  };
}

const { closing } = Astro.props;
const info = closing.info ?? [];
const highlightedTitle = closing.title.match(/^(.*\s)(again\.?)$/i);
---

<Section aria-labelledby="closing-title">
  <div class="rounded-panel flex min-h-96 w-full flex-col items-center justify-center bg-coral-tint px-4 py-16 text-center md:px-12 md:py-20 lg:py-24">
    <div class="w-full">
      {info.length >= 2 && (
        <div class="mb-5">
          <p class="sr-only">{info.join(' · ')}</p>
          <div data-hero-trust-cycler aria-hidden="true" class="text-sm text-ink/80">
            <span data-slot class="grid min-h-10 grid-cols-1 grid-rows-1 items-center">
              <span data-index="0" data-roll class="col-start-1 row-start-1">
                <RollPhrase text={info[0]} />
              </span>
            </span>
            <template data-pool>
              {info.map((item, index) => (
                <span data-index={index} data-roll class="col-start-1 row-start-1">
                  <RollPhrase text={item} />
                </span>
              ))}
            </template>
          </div>
        </div>
      )}
      <h2 id="closing-title" class="text-display text-ink lg:whitespace-nowrap">
        {highlightedTitle ? (
          <>
            {highlightedTitle[1]}
            <span class="relative inline-block whitespace-nowrap">
              <span
                class="closing-highlight absolute inset-x-0 bottom-0 h-3 origin-left -skew-x-12 bg-coral"
                data-closing-highlight
                aria-hidden="true"
              ></span>
              <span class="relative">{highlightedTitle[2]}</span>
            </span>
          </>
        ) : (
          closing.title
        )}
      </h2>
      {closing.body && (
        <p class="mx-auto mt-heading max-w-measure text-lead text-ink/80">{closing.body}</p>
      )}
      <Button href={BOOKING_URL} class="mt-action">
        <RollText text={closing.cta} />
      </Button>
    </div>
  </div>
</Section>

<script>
  import '../../scripts/hero-trust-cycler';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-closing-highlight]').forEach((marker) => {
    if (reduceMotion.matches) return;

    const title = marker.closest('h2');
    if (!title) return;

    marker.toggleAttribute('data-highlight-pending', true);

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting || entry.intersectionRatio < 0.99) return;

        observer.disconnect();
        requestAnimationFrame(() => marker.toggleAttribute('data-highlighted', true));
      },
      { threshold: 0.99 },
    );

    observer.observe(title);
  });
</script>
