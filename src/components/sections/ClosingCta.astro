---
import { BOOKING_URL } from '../../config';
import type { Home } from '../../lib/schemas';
import Button from '../ui/Button.astro';
import Panel from '../ui/Panel.astro';
import Section from '../ui/Section.astro';

interface Props {
  closing: Omit<Home['closing'], 'body'> & { body?: string | undefined };
}

const { closing } = Astro.props;
---

<Section spacing="compact" aria-labelledby="closing-title">
  <!-- -mx cancels the Container gutters, so the panel is as wide as the footer's dark block. -->
  <Panel class="-mx-4 px-6 py-12 text-center md:-mx-6 md:px-12 md:py-14 lg:py-16">
    <div class="mx-auto max-w-2xl">
      <h2 id="closing-title" class="text-h2 text-ink">
        {closing.title}
      </h2>
      {closing.body && <p class="mt-heading text-lead text-ink/80">{closing.body}</p>}
      <Button href={BOOKING_URL} class="mt-action">
        {closing.cta}
      </Button>
    </div>
  </Panel>
</Section>
