---
import FileIcon from './FileIcon.astro';

// The lab results card's contents in the video scene: a title and three abstract bar rows. No
// values or ranges on purpose: nothing that reads as data or an outcome.
interface Props {
  label: string;
}

const { label } = Astro.props;
const rows = ['w-3/4', 'w-1/2', 'w-2/3'];
---

<div class="flex items-center gap-2 text-sm font-medium text-ink">
  <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-coral-tint">
    <FileIcon class="size-3.5" />
  </span>
  {label}
</div>
<div class="mt-3 space-y-2">
  {rows.map((width) => (
    <div class="flex items-center gap-2">
      <span class="h-1.5 w-8 shrink-0 rounded-full bg-ink/10" />
      <span class="h-1.5 flex-1 rounded-full bg-surface">
        <span class:list={['block h-full rounded-full bg-coral-tint', width]} />
      </span>
    </div>
  ))}
</div>
