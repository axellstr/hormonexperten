---
// A done mark in the step scenes: a check in a coral-tint circle, optionally ringed.
interface Props {
  ring?: boolean;
  class?: string;
}

const { ring = false, class: className } = Astro.props;
---

<span
  class:list={[
    'flex shrink-0 items-center justify-center rounded-full bg-coral-tint text-ink',
    ring ? 'size-6 ring-1 ring-coral' : 'size-5',
    className,
  ]}
>
  <svg
    class="size-3.5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M20 6 9 17l-5-5"></path>
  </svg>
</span>
