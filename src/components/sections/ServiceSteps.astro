---
import Info from '../../assets/icons/info.svg';
import type { Home } from '../../lib/schemas';
import Eyebrow from '../ui/Eyebrow.astro';
import Panel from '../ui/Panel.astro';
import Section from '../ui/Section.astro';

interface Props {
  how: Home['how'];
}

const { how } = Astro.props;
---

<!-- The home page's How it Works, without the step photos: three cards in a row from lg. -->
<Section id="how-it-works" aria-labelledby="how-title">
  <Eyebrow>{how.eyebrow}</Eyebrow>
  <h2 id="how-title" class="mt-4 max-w-3xl text-h2 text-ink">
    {how.title}
  </h2>
  <p class="mt-5 max-w-3xl text-lead text-ink/80">{how.intro}</p>

  <ol class="mt-10 grid gap-4 lg:mt-14 lg:grid-cols-3 lg:gap-6">
    {how.steps.map((step, index) => (
      <li>
        <Panel class="h-full p-6 md:p-8 xl:p-10">
          <h3 class="text-h3 text-ink">
            <span class="text-text-muted tabular-nums" aria-hidden="true">
              {`${index + 1}.`}
            </span>{' '}
            {step.title}
          </h3>
          <p class="mt-4 text-body text-ink/80">{step.body}</p>
        </Panel>
      </li>
    ))}
  </ol>

  <div
    role="note"
    class="mt-6 flex flex-col gap-4 rounded-card p-6 ring-1 ring-ink/10 sm:flex-row sm:gap-6 md:p-8 xl:p-10"
  >
    <Info class="size-11 shrink-0 text-ink" aria-hidden="true" />
    <div>
      <h3 class="text-h4 text-ink">{how.note.title}</h3>
      <p class="mt-3 max-w-prose text-body text-ink/80">{how.note.body}</p>
    </div>
  </div>
</Section>
