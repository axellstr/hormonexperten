---
import Clock from '../../assets/icons/clock.svg';
import Connected from '../../assets/icons/connected.svg';
import Layers from '../../assets/icons/layers.svg';
import Sunrise from '../../assets/icons/sunrise.svg';
import type { ApproachPage } from '../../lib/schemas';
import RevealText from '../ui/RevealText.astro';
import Section from '../ui/Section.astro';

interface Props {
  pillars: ApproachPage['pillars'];
}

const { pillars } = Astro.props;
const icons = { clock: Clock, connected: Connected, layers: Layers, sunrise: Sunrise };
// Each card's place in its row sets how long it waits to rise: pairs on tablets, four on desktop.
const lags = ['', 'md:pillar-lag-1', 'xl:pillar-lag-2', 'md:pillar-lag-1 xl:pillar-lag-3'];
---

<!--
  Four warm cards side by side, as in the landing page's card rows: two by two on tablets, one
  under another on phones. Each card is a subgrid of the row, so icons, titles and texts line up
  across it even when a title wraps or one text runs longer. They rise in one after another as
  the row scrolls into view (`pillar` in global.css).
-->
<Section aria-labelledby="pillars-title">
  <h2 id="pillars-title" class="max-w-3xl reveal-text text-h2 text-ink">
    <RevealText text={pillars.title} />
  </h2>

  <ol class="mt-intro grid gap-4 md:grid-cols-2 lg:gap-6 xl:grid-cols-4">
    {pillars.items.map((pillar, index) => {
      const Icon = icons[pillar.icon];
      return (
        <li
          class:list={[
            'pillar row-span-3 grid grid-rows-subgrid gap-y-0 rounded-card bg-surface p-6 md:p-8',
            lags[index % lags.length],
          ]}
        >
          <div class="flex items-start justify-between gap-4">
            <span class="pillar-icon grid size-12 shrink-0 place-items-center rounded-full bg-coral-tint text-ink">
              <Icon class="pillar-draw size-6" aria-hidden="true" />
            </span>
            <span class="text-sm font-medium text-text-muted tabular-nums" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
          </div>
          <h3 class="mt-8 text-h4 text-ink lg:mt-12">{pillar.title}</h3>
          <p class="mt-label text-base text-ink/80">{pillar.body}</p>
        </li>
      );
    })}
  </ol>
</Section>
