---
import type { Locale } from '../../config';
import { IMAGE_QUALITY, getImage } from '../../lib/assets';
import { visible } from '../../lib/content';
import { localizeHref } from '../../lib/i18n';
import type { Home } from '../../lib/schemas';
import Button from '../ui/Button.astro';
import Photo from '../ui/Photo.astro';
import Placeholder from '../ui/Placeholder.astro';
import RollText from '../ui/RollText.astro';
import Section from '../ui/Section.astro';

interface Props {
  lang: Locale;
  team: Home['team'];
}

const { lang, team } = Astro.props;
---

<Section id="team" aria-labelledby="team-title">
  <h2 id="team-title" class="max-w-3xl text-h2 text-ink">
    {team.title}
  </h2>

  <ul class="mt-intro grid gap-14 md:grid-cols-2 lg:gap-16">
    {visible(team.members).map((member) => (
      <li class="flex flex-col md:even:unveil-late">
        <div class="unveil overflow-hidden rounded-panel">
          {member.image ? (
            <Photo
              quality={IMAGE_QUALITY}
              src={getImage(member.image)}
              alt={member.image_alt ?? ''}
              widths={[480, 720, 960, 1300]}
              sizes="(min-width: 1440px) 680px, (min-width: 768px) 45vw, 90vw"
              class="unveil-photo aspect-3/2 w-full object-cover object-top lg:aspect-5/4"
            />
          ) : (
            <Placeholder class="aspect-3/2 w-full lg:aspect-5/4" />
          )}
        </div>
        <h3 class="mt-6 text-h3 text-ink">{member.name}</h3>
        <p class="mt-subheading max-w-measure text-body text-ink/80">{member.role}</p>
        <Button href={localizeHref(member.cta.href, lang)} class="mt-action self-start">
          <RollText text={member.cta.label} />
          <span class="sr-only">: {member.name}</span>
        </Button>
      </li>
    ))}
  </ul>
</Section>
