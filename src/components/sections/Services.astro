---
import ChevronEnd from '../../assets/icons/chevron-end.svg';
import type { Locale } from '../../config';
import { getImage } from '../../lib/assets';
import { visible } from '../../lib/content';
import { localizeHref } from '../../lib/i18n';
import type { Home, Site } from '../../lib/schemas';
import Photo from '../ui/Photo.astro';
import Placeholder from '../ui/Placeholder.astro';
import RevealText from '../ui/RevealText.astro';
import Section from '../ui/Section.astro';

interface Props {
  lang: Locale;
  content: Home['services'];
  services: Site['services'];
}

const { lang, content, services } = Astro.props;

const arrow =
  'grid size-11 cursor-pointer place-items-center rounded-full bg-surface text-ink hover:bg-coral-tint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink aria-disabled:cursor-default aria-disabled:text-ink/30 aria-disabled:hover:bg-surface motion-safe:transition-colors';

// German, Greek and Russian service names run long ("Betreuung bei chronischen Erkrankungen"),
// so their cards are wider and the titles stay on one line.
const wide = lang !== 'en';
const cardWidth = wide
  ? 'w-4/5 sm:w-2/3 md:w-3/5 lg:w-1/2 xl:w-2/5 header-desktop:w-1/3'
  : 'w-4/5 sm:w-1/2 lg:w-2/5 xl:w-1/3 header-desktop:w-1/4';
const photoSizes = wide
  ? '(min-width: 1440px) 450px, (min-width: 1280px) 31vw, (min-width: 1024px) 45vw, (min-width: 768px) 57vw, (min-width: 640px) 64vw, 80vw'
  : '(min-width: 1440px) 330px, (min-width: 1024px) 23vw, (min-width: 768px) 45vw, 80vw';
---

<Section id="services" aria-labelledby="services-title" class="pt-footer!">
  <div class="flex items-end justify-between gap-6">
    <h2 id="services-title" class="min-w-0 flex-1 reveal-text text-h2 text-ink">
      <RevealText text={content.title} />
    </h2>

    <!-- Shown by service-rail.ts once the row overflows. Phones swipe instead. -->
    <div class="hidden shrink-0 gap-3 md:flex" data-rail-controls hidden>
      <button type="button" class={arrow} aria-controls="services-rail" data-rail-step="-1">
        <ChevronEnd class="size-5 -scale-x-100 rtl:scale-x-100" aria-hidden="true" />
        <span class="sr-only">{content.previous}</span>
      </button>
      <button type="button" class={arrow} aria-controls="services-rail" data-rail-step="1">
        <ChevronEnd class="size-5 rtl:-scale-x-100" aria-hidden="true" />
        <span class="sr-only">{content.next}</span>
      </button>
    </div>
  </div>

  <!--
    One row of cards, clipped at the content edge: four fit on desktop, two on tablets, one and a
    peek on phones, and the rest wait off to the right. Each card's padding is the gap, so
    `lg:w-1/4` is exactly a quarter of the row and the next card stays hidden until the row moves.
    service-rail.ts drives the arrows and slides the row one card on once it has been in view a moment.
  -->
  <div class="mt-intro">
    <ul
      id="services-rail"
      class="-mx-4 -my-2 flex snap-x snap-mandatory scroll-ps-2 overflow-x-auto px-2 py-2 scrollbar-none data-moving:snap-none md:-mx-3 md:scroll-ps-0 md:px-0"
      data-service-rail
    >
      {visible(services).map((service) => (
        <li class:list={['shrink-0 snap-start px-2 md:px-3', cardWidth]}>
          <a
            href={localizeHref(service.href, lang)}
            class="group flex h-full flex-col gap-4 rounded-card focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
          >
            <h3 class="text-h4 text-ink md:whitespace-nowrap">{service.title}</h3>
            <!--
              4:5 at least, taller when the summary needs it (phones, longer languages): `overflow-clip`
              isn't a scroll container, so the aspect ratio still grows to fit its content. `grow`
              keeps every card in the row as tall as the tallest.
            -->
            <div class="relative flex aspect-4/5 grow flex-col justify-end overflow-clip rounded-card">
              {service.image ? (
                <Photo
                  src={getImage(service.image)}
                  alt={service.image_alt}
                  widths={[320, 480, 640]}
                  sizes={photoSizes}
                  class="absolute inset-0 size-full object-cover motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:scale-105"
                />
              ) : (
                <Placeholder class="absolute inset-0" />
              )}
              <div class="relative bg-linear-to-b from-transparent via-footer/60 via-30% to-footer/80 px-6 pt-16 pb-6">
                <p class="text-base text-on-dark">{service.summary}</p>
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Section>

<script>
  import '../../scripts/service-rail';
</script>
