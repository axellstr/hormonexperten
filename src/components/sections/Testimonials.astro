---
import Avatar from '../../assets/icons/avatar.svg';
import Google from '../../assets/icons/google.svg';
import Jameda from '../../assets/icons/jameda.svg';
import ProvenExpert from '../../assets/icons/provenexpert.svg';
import Star from '../../assets/icons/star.svg';
import type { Locale } from '../../config';
import { getLogo } from '../../lib/assets';
import { textLang, visible } from '../../lib/content';
import { format } from '../../lib/i18n';
import type { Home } from '../../lib/schemas';
import Card from '../ui/Card.astro';
import Panel from '../ui/Panel.astro';
import Section from '../ui/Section.astro';

interface Props {
  lang: Locale;
  testimonials: Home['testimonials'];
  reviewProfile: Home['review_profile'];
}

const { lang, testimonials, reviewProfile } = Astro.props;
const items = visible(testimonials.items);
// Untranslated reviews and note fall back to English; say so for screen readers.
const fallback = (path: string[]) => {
  const used = textLang('home', lang, ['testimonials', ...path]);
  return used === lang ? undefined : used;
};
const sourceIcons: Record<string, typeof Jameda> = { Jameda, ProvenExpert, Google };
const platforms = visible(reviewProfile.platforms).map((platform) => ({
  ...platform,
  image: getLogo(platform.logo),
  reviewsText: format(reviewProfile.platform_reviews_label, {
    count: platform.reviews,
  }),
}));

// Keep a full repeated set on either side so drag-to-pan can wrap without a visible jump.
const copies = Math.max(3, Math.ceil(8 / Math.max(items.length, 1)));
const row = Array.from({ length: copies }, () => items).flat();

const cardClass =
  'flex flex-col items-center gap-2 rounded-field px-2 py-2 text-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink';
---

{(items.length > 0 || platforms.length > 0) && (
  <Section id="testimonials" aria-labelledby="testimonials-title">
    <h2 id="testimonials-title" class="text-center text-h2 text-ink">
      {testimonials.title}
    </h2>

    {platforms.length > 0 && (
      <>
        <!-- Mobile assistive copy; the cycler below is decorative. -->
        <ul class="sr-only sm:hidden">
          {platforms.map((platform) => (
            <li>
              <a href={platform.href} target="_blank" rel="noopener noreferrer">
                {platform.link_label}: {platform.reviewsText}
              </a>
            </li>
          ))}
        </ul>

        <!--
          Mobile: horizontal 2D carousel. Centre card at 80% opacity, neighbours quieter;
          the track slides on X and loops via tripled items (review-source-cycler.ts).
        -->
        <div
          data-review-cycler
          data-count={platforms.length}
          aria-hidden="true"
          class="relative mx-auto mt-6 w-full max-w-sm overflow-hidden sm:hidden"
        >
          <ul
            data-track
            class="flex w-max items-start gap-3 will-change-transform motion-safe:transition-transform motion-safe:duration-700 motion-safe:ease-smooth"
          >
            {Array.from({ length: 3 }, () => platforms)
              .flat()
              .map((platform, index) => (
                <li class="w-36 shrink-0">
                  <a
                    href={platform.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-index={index % platforms.length}
                    tabindex="-1"
                    class:list={[
                      cardClass,
                      'w-full motion-safe:transition-opacity motion-safe:duration-700 motion-safe:ease-smooth',
                    ]}
                    style={`opacity: ${index % platforms.length === 0 ? 0.8 : 0.35}`}
                  >
                    <img
                      src={platform.image.src}
                      width={platform.image.width}
                      height={platform.image.height}
                      alt=""
                      loading={index < platforms.length ? 'lazy' : undefined}
                      decoding="async"
                      class="mx-auto h-7 w-auto max-w-full object-contain"
                    />
                    <span class="tabular-nums text-sm text-ink/70">
                      {platform.reviewsText}
                    </span>
                  </a>
                </li>
              ))}
          </ul>
          <!-- Soft edge fades so side cards ease out instead of cutting off. -->
          <div class="pointer-events-none absolute inset-y-0 start-0 w-16 bg-linear-to-r from-bg to-transparent"></div>
          <div class="pointer-events-none absolute inset-y-0 end-0 w-16 bg-linear-to-l from-bg to-transparent"></div>
        </div>

        <!-- sm+: all three sources in a row (the accessible links at this size). -->
        <ul class="mx-auto mt-6 hidden max-w-3xl grid-cols-3 gap-x-6 sm:mt-8 sm:grid">
          {platforms.map((platform) => (
            <li>
              <a
                href={platform.href}
                target="_blank"
                rel="noopener noreferrer"
                class={cardClass}
                aria-label={`${platform.link_label}: ${platform.reviewsText}`}
              >
                <img
                  src={platform.image.src}
                  width={platform.image.width}
                  height={platform.image.height}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="h-7 w-auto max-w-full object-contain md:h-8"
                />
                <span class="tabular-nums text-sm text-ink/70">{platform.reviewsText}</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}

    {items.length > 0 && (
      <Panel
        lang={fallback(['items'])}
        class="mt-intro overflow-hidden py-12 [--review-pitch:calc(18rem+0.5rem)] lg:py-20 lg:[--review-pitch:calc(var(--container-md)+2.5rem)]"
      >
        <!--
          Two centered rows, clipped on both sides. The second row's start margin is one
          pitch, which centering turns into a half-card stagger. grab-scroll.ts makes
          each row pannable. Small screens use the same arrangement at a smaller card size.
        -->
        <div class="flex flex-col gap-3 lg:gap-8">
          {[false, true].map((staggered) => (
            <div
              class="flex min-w-0 cursor-grab justify-center overflow-hidden scrollbar-none select-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ink active:cursor-grabbing"
              data-grab
              data-stagger={staggered ? '' : undefined}
              data-cycle-items={items.length}
              tabindex={staggered ? -1 : 0}
              aria-label={staggered ? undefined : testimonials.title}
              aria-hidden={staggered ? 'true' : undefined}
            >
              <ul class:list={['flex w-max gap-2 lg:gap-10', staggered && 'ms-(--review-pitch)']}>
                {row.map((item, index) => {
                  const SourceIcon = sourceIcons[item.source];
                  const duplicate = index >= items.length;
                  return (
                    <li
                      class="flex w-72 shrink-0 lg:w-md"
                      aria-hidden={duplicate ? 'true' : undefined}
                    >
                      <Card class="flex h-full w-full items-start gap-3 p-4 lg:gap-5 lg:p-5">
                        <Avatar
                          class="size-10 shrink-0 overflow-hidden rounded-full lg:size-16"
                          aria-hidden="true"
                        />
                        <figure class="min-w-0 flex-1">
                          <div
                            role="img"
                            aria-label={format(testimonials.rating_label, { rating: item.rating })}
                            class="flex gap-0.5 text-coral"
                          >
                            {Array.from({ length: item.rating }, () => (
                              <Star class="size-2.5 lg:size-3" aria-hidden="true" />
                            ))}
                          </div>
                          <blockquote class="mt-1.5 lg:mt-2.5">
                            <p class="line-clamp-2 text-sm font-semibold text-ink lg:line-clamp-none lg:text-base">
                              {item.title}
                            </p>
                            {item.body && (
                              <p class="mt-1.5 line-clamp-4 text-sm text-ink/80 lg:mt-2.5 lg:line-clamp-none">
                                {item.body}
                              </p>
                            )}
                          </blockquote>
                          <figcaption class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-sm text-ink/80 lg:mt-5">
                            <span>{item.author}</span>
                            <span class="inline-flex items-center gap-1">
                              {SourceIcon && (
                                <SourceIcon
                                  class="size-3 text-coral lg:size-3.5"
                                  aria-hidden="true"
                                />
                              )}
                              {item.source}
                            </span>
                          </figcaption>
                        </figure>
                      </Card>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </div>
      </Panel>
    )}

    {items.length > 0 && testimonials.translation_note && (
      <p lang={fallback(['translation_note'])} class="mt-4 text-center text-sm text-ink/70">
        {testimonials.translation_note}
      </p>
    )}
  </Section>
)}

<script>
  import '../../scripts/grab-scroll';
  import '../../scripts/review-source-cycler';
</script>
